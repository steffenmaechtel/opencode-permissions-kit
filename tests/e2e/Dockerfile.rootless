FROM ubuntu:24.04

# Systemd-based image for the docker-rootless daemon e2e
# (tests/e2e/run-docker-rootless.sh). The kit's docker-rootless provisioning
# (setup-container-backend.sh) requires a working systemd --user manager
# (dockerd-rootless-setuptool.sh + `systemctl --user`), so this image runs
# systemd as PID 1. The plain e2e suite uses Dockerfile (no systemd).
#
# Run requirements (see run-docker-rootless.sh E2E_RUN_ARGS):
#   --privileged            (nested user namespaces + /dev/fuse for
#                            fuse-overlayfs)
#   --cgroupns=private      (Docker default; the nested ROOTLESS inner dockerd
#                            only works when its /proc/self/cgroup paths match
#                            its /sys/fs/cgroup view — see below)
#   --tmpfs /run:rw,mode=755 --tmpfs /run/lock --tmpfs /tmp:rw
#                           (systemd runtime dirs)
#
# The systemd container runs with --cgroupns=private and WITHOUT any
# /sys/fs/cgroup bind on BOTH outer-docker layouts. The classic cgroupns=host +
# host cgroup bind makes systemd boot but breaks the nested ROOTLESS inner
# dockerd: it looks for user.slice/user-<uid>.slice at the visible host-root
# tree, where it does not exist, so every inner `docker run` fails with "no
# such file or directory". Only the nested-userns subuid seed differs between
# the two layouts (see run-docker-rootless.sh):

ENV DEBIAN_FRONTEND=noninteractive

# systemd + the pieces dockerd-rootless needs that apt does not install as
# hard dependencies of docker-ce-rootless-extras on Ubuntu. fuse-overlayfs is
# the rootless storage driver fallback (overlay2 under user namespaces);
# slirp4netns is rootlesskit's default network driver; uidmap/dbus-user-session
# are the kit's own prerequisites (installed again by the helper if missing,
# harmless to pre-install). iproute2 provides the `ip tuntap` call
# rootlesskit's slirp4netns setup needs (a userns container can never run
# dockerd-rootless without it).
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    systemd systemd-sysv dbus \
    sudo curl git acl python3 ca-certificates nodejs npm \
    uidmap dbus-user-session slirp4netns fuse-overlayfs iproute2 \
    && rm -rf /var/lib/apt/lists/*

# dockerd-rootless-setuptool.sh refuses to run unless the nf_tables (or
# ip_tables) kernel module shows up in /proc/modules or in the kernel's
# modules.builtin list. The host kernel (WSL2 / CI runner) has nf_tables
# BUILT-IN — iptables and nft demonstrably work here — but a container never
# ships /lib/modules metadata, so the check fails. Synthesize the metadata a
# real linux-modules install for the running kernel would provide.
RUN mkdir -p "/lib/modules/$(uname -r)" \
    && printf 'kernel/net/netfilter/nf_tables.ko\nkernel/net/ipv4/netfilter/ip_tables.ko\n' > "/lib/modules/$(uname -r)/modules.builtin"

RUN useradd -m -s /bin/bash -G sudo dev \
    && echo 'dev ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/dev \
    && chmod 440 /etc/sudoers.d/dev

RUN mkdir -p /var/www/vhosts/test-project \
    && chown dev:dev /var/www/vhosts /var/www/vhosts/test-project

RUN groupadd -f www-data

# systemd as PID 1.
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
