{
    "$schema": "https://opencode.ai/config.json",
    // opencode permissions kit — default permission template
    // SOFT PROTECTION ONLY: these rules are enforced by opencode's own
    // permission layer. The kit no longer mirrors them into Linux ACLs —
    // see docs/design/DDEV-WORKING.md. Processes spawned outside opencode
    // (ddev, its containers) are NOT restricted by them.
    // Bash is ask-by-default ("*": "ask"): every bash command prompts unless
    // explicitly allowlisted or denied below. The long ask-blacklist of the
    // early templates is gone — the default IS ask — so only an allowlist and
    // a hard denylist remain. No broad ask rules means an "always allow"
    // approval can never override a deny rule either.
    // NOTE: opencode's "always allow" approvals are only per-session (not
    // persisted), so extend the allowlist below as you go.

    "share": "disabled",
    // Auto-update is disabled on purpose: the binary is root-owned and
    // opencode runs as an unprivileged user, so self-update cannot work
    // behind the wrapper. Upgrade via: sudo update.sh --binary
    "autoupdate": false,
    "permission": {
        "read": {
            "*": "allow",
            // TYPO3
            "*additional.php": "deny",
            "*settings.php": "deny",
            // TYPO3 Legacy
            "*LocalConfiguration.php": "deny",
            "*AdditionalConfiguration.php": "deny",
            // Misc
            "*README.md": "deny",
            // Soft deny is ddev-safe: ddev reads .ddev/commands/<svc>/README.txt
            // as a separate process outside opencode's permission layer, so this
            // rule never affects `ddev start`.
            "*README.txt": "deny",
            "*.sql.gz": "deny",
            "*auth.json": "deny",
            // ".env*" catches .env, .env.local, .env.example AND foo.env
            "*.env*": "deny",
            // Private Keys
            "*id_rsa*": "deny",
            "*id_ed25519*": "deny",
            "*.pem": "deny",
            // WordPress
            "*wp-config.php": "deny",
            // Legacy Projects
            // "*config.php" also covers "wp-config.php" and "myconfig.php"
            "*conf.php": "deny",
            "*config.php": "deny",
            //SECURE_GIT: ".git/config": "deny",
            //SECURE_GIT: "**/.git/config": "deny",
            "*config/database.php": "deny"
        },
        "edit": {
            "*": "allow",
            // TYPO3
            "*additional.php": "deny",
            "*settings.php": "deny",
            // TYPO3 Legacy
            "*LocalConfiguration.php": "deny",
            "*AdditionalConfiguration.php": "deny",
            // Misc
            "*README.md": "deny",
            // Soft deny is ddev-safe: ddev reads .ddev/commands/<svc>/README.txt
            // as a separate process outside opencode's permission layer, so this
            // rule never affects `ddev start`.
            "*README.txt": "deny",
            "*.sql.gz": "deny",
            "*auth.json": "deny",
            // ".env*" catches .env, .env.local, .env.example AND foo.env
            "*.env*": "deny",
            // Private Keys
            "*id_rsa*": "deny",
            "*id_ed25519*": "deny",
            "*.pem": "deny",
            // WordPress
            "*wp-config.php": "deny",
            // Legacy Projects
            // "*config.php" also covers "wp-config.php" and "myconfig.php"
            "*conf.php": "deny",
            "*config.php": "deny",
            //SECURE_GIT: ".git/config": "deny",
            //SECURE_GIT: "**/.git/config": "deny",
            "*config/database.php": "deny"
        },
        "bash": {
            // DEFAULT-ASK: every bash command prompts unless explicitly
            // allowlisted or denied below. Last matching rule wins.
            "*": "ask",
            // ALLOW — provably harmless, read-only commands. Keep this list
            // tight: never allow prefixes with destructive subcommands
            // (git *, find *, chmod *, rm *, ...). cat/git config stay ask —
            // they read file content via bash and would bypass the read
            // denies above.
            "ls *": "allow",
            "pwd": "allow",
            "whoami": "allow",
            "id *": "allow",
            "uname *": "allow",
            "date *": "allow",
            "df *": "allow",
            "du *": "allow",
            "git status *": "allow",
            "git diff *": "allow",
            "git log *": "allow",
            // SYSTEM PROTECTION — destructive system commands, never allow.
            // Must come AFTER the allow rules: opencode applies the LAST
            // matching rule, so these override any broader allow above.
            "rm -rf /*": "deny",
            ">: /dev/sd*": "deny",
            "dd if=/dev/zero*": "deny",
            "dd of=/dev/sd*": "deny",
            "dd if=/dev/urandom of=/*": "deny",
            "mkfs*": "deny",
            "mkswap*": "deny",
            "swapon*": "deny",
            "fsck*": "deny",
            "chmod 777 /*": "deny",
            "chmod -R 777 /*": "deny",
            "chown -R * /*": "deny",
            "chgrp -R * /*": "deny",
            "mount *": "deny",
            "> /etc/*": "deny",
            "shred /*": "deny",
            // CONTAINER TOOLS — the global config denies docker/ddev so
            // nothing is granted implicitly; a project opts in via its own
            // opencode.jsonc (docker/ddev then run natively as this user
            // against the rootless backend). "docker *" also covers
            // "docker compose ..." and the bare "docker" command; the
            // hyphenated "docker-compose *" is a separate binary.
            "docker *": "deny",
            "docker-compose *": "deny",
            "sudo docker *": "deny",
            "sudo docker-compose *": "deny",
            "ddev *": "deny",
            "sudo ddev *": "deny",
            // CREDENTIAL IMPORT — `ddev auth ssh` copies the given private
            // key into /home/opencode/.ddev/.ssh (this user's home): once
            // imported, EVERY opencode session can read it from disk. The
            // read/edit denies (*id_rsa*, *.pem, ...) and the bash
            // tripwires below still gate the tools, but the file itself is
            // user-readable — that is the documented trade-off of "ddev
            // always runs as opencode". Keep the import a developer-
            // terminal task. NOTE: if a project config allows "ddev *",
            // project rules merge LAST and override this deny — re-add
            // "ddev auth ssh*": "deny" AFTER the allow in the project's
            // opencode.jsonc to keep the gate. Composer private-repo auth
            // rides the same ssh-agent (ddev auth ssh).
            "ddev auth ssh*": "deny",
            "sudo ddev auth ssh*": "deny",
            // SENSITIVE FILE TRIPWIRE — mirrors the read/edit deny patterns
            // into bash so allowlisted commands (git log *, git diff *, ls *,
            // ...) cannot touch protected file names prompt-free. "ask" (not
            // "deny"): the developer decides per case whether a match is a
            // false positive (cp .env.example .env) or an unwanted access.
            // Must stay AFTER the allow rules (last match wins). Patterns are
            // anchored with a TRAILING "*" — unlike read/edit (which match
            // file paths), bash rules match the whole command string, so a
            // name mid-command (cat settings.php | grep DB, cp auth.json /tmp)
            // must still hit. Still LEXICAL ONLY — variables (F=.env; cat $F),
            // globs (cat .en?) and indirection (find -exec cat {} \;) evade
            // it. With the hard ACL layer gone this is the LAST line of
            // defense for bash-spawned reads — treat matches seriously.
            "*additional.php*": "ask",
            "*settings.php*": "ask",
            "*LocalConfiguration.php*": "ask",
            "*AdditionalConfiguration.php*": "ask",
            "*README.md*": "ask",
            "*README.txt*": "ask",
            "*.sql.gz*": "ask",
            "*auth.json*": "ask",
            "*.env*": "ask",
            "*id_rsa*": "ask",
            "*id_ed25519*": "ask",
            "*.pem*": "ask",
            "*wp-config.php*": "ask",
            "*conf.php*": "ask",
            "*config.php*": "ask",
            "*config/database.php*": "ask",
            // Pairs with the git-config toggle: even with the read/edit deny
            // inactive, bash commands naming .git/config (cat .git/config)
            // trip an ask.
            "*.git/config*": "ask"
        },
        "external_directory": "ask"
    }
}
