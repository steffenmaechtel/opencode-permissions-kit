{
    "$schema": "https://opencode.ai/config.json",
    // opencode permissions kit — default permission template
    // Customize this file to add project-specific rules or allowed commands.

    "share": "disabled",
    // Auto-update is disabled on purpose: the binary is root-owned and
    // opencode runs as an unprivileged user, so self-update cannot work
    // behind the wrapper. Upgrade via: sudo update.sh --binary
    "autoupdate": false,
    "permission": {
        "read": {
            "*": "allow",
            // TYPO3
            "additional.php": "deny",
            "**/additional.php": "deny",
            "settings.php": "deny",
            "**/settings.php": "deny",
            // TYPO3 Legacy
            "LocalConfiguration.php": "deny",
            "**/LocalConfiguration.php": "deny",
            "AdditionalConfiguration.php": "deny",
            "**/AdditionalConfiguration.php": "deny",
            // Misc
            "README.md": "deny",
            "**/README.md": "deny",
            "README.txt": "deny",
            "**/README.txt": "deny",
            "*.sql.gz": "deny",
            "**/*.sql.gz": "deny",
            "auth.json": "deny",
            "**/auth.json": "deny",
            ".env*": "deny",
            "**/*.env": "deny",
            "**/*.env.*": "deny",
            "**/*.env.example": "deny",
            // Private Keys
            "*id_rsa*": "deny",
            "**/*id_rsa*": "deny",
            "*id_ed25519*": "deny",
            "**/*id_ed25519*": "deny",
            "*.pem": "deny",
            "**/*.pem": "deny",
            // WordPress
            "wp-config.php": "deny",
            "**/wp-config.php": "deny",
            // Legacy Projects
            "conf.php": "deny",
            "**/conf.php": "deny",
            "config.php": "deny",
            "**/config.php": "deny",
            "config/database.php": "deny",
            //SECURE_GIT: ".git/config": "deny",
            //SECURE_GIT: "**/.git/config": "deny",
            "**/config/database.php": "deny"
        },
        "edit": {
            "*": "allow",
            // TYPO3
            "additional.php": "deny",
            "**/additional.php": "deny",
            "settings.php": "deny",
            "**/settings.php": "deny",
            // TYPO3 Legacy
            "LocalConfiguration.php": "deny",
            "**/LocalConfiguration.php": "deny",
            "AdditionalConfiguration.php": "deny",
            "**/AdditionalConfiguration.php": "deny",
            // Misc
            "README.md": "deny",
            "**/README.md": "deny",
            "README.txt": "deny",
            "**/README.txt": "deny",
            "*.sql.gz": "deny",
            "**/*.sql.gz": "deny",
            "auth.json": "deny",
            "**/auth.json": "deny",
            ".env*": "deny",
            "**/*.env": "deny",
            "**/*.env.*": "deny",
            "**/*.env.example": "deny",
            // Private Keys
            "*id_rsa*": "deny",
            "**/*id_rsa*": "deny",
            "*id_ed25519*": "deny",
            "**/*id_ed25519*": "deny",
            "*.pem": "deny",
            "**/*.pem": "deny",
            // WordPress
            "wp-config.php": "deny",
            "**/wp-config.php": "deny",
            // Legacy Projects
            "conf.php": "deny",
            "**/conf.php": "deny",
            "config.php": "deny",
            "**/config.php": "deny",
            "config/database.php": "deny",
            //SECURE_GIT: ".git/config": "deny",
            //SECURE_GIT: "**/.git/config": "deny",
            "**/config/database.php": "deny"
        },
        "bash": {
            // Allow
            "*": "allow",
            "curl *": "allow",
            "wget *": "allow",
            // SYSTEM PROTECTION — destructive system commands, never allow
            "rm -rf /*": "deny",
            "rm -rf /": "deny",
            "rm -rf /etc*": "deny",
            "rm -rf /boot*": "deny",
            "rm -rf /usr*": "deny",
            "rm -rf /home*": "deny",
            ">: /dev/sd*": "deny",
            "dd if=/dev/zero*": "deny",
            "dd of=/dev/sd*": "deny",
            "dd if=/dev/urandom of=/*": "deny",
            "mkfs*": "deny",
            "mkswap*": "deny",
            "swapon*": "deny",
            "fsck*": "deny",
            "chmod 777 /*": "deny",
            "chmod -R 777 /*": "deny",
            "chown -R * /*": "deny",
            "chgrp -R * /*": "deny",
            "mount *": "deny",
            "> /etc/*": "deny",
            "shred /*": "deny",
            // ASK — potentially destructive commands
            "rm *": "ask",
            "rmdir *": "ask",
            "unlink *": "ask",
            "shred *": "ask",
            "dd *": "ask",
            "mv *": "ask",
            "chmod *": "ask",
            "chown *": "ask",
            "chgrp *": "ask",
            "truncate *": "ask",
            "find *-delete*": "ask",
            "find *-exec*rm*": "ask",
            "sudo *": "ask",
            "su *": "ask",
            "scp *": "ask",
            "rsync *": "ask",
            "git *": "ask",
            "mysql *DROP DATABASE*": "ask",
            "mysql *drop database*": "ask",
            "mysql *DROP TABLE*": "ask",
            "mysql *drop table*": "ask",
            "mysql *TRUNCATE*": "ask",
            "mysql *truncate*": "ask",
            "mysql *DELETE FROM*": "ask",
            "mysql *delete from*": "ask",
            "mysqladmin *drop*": "ask",
            "ddev *DROP DATABASE*": "ask",
            "ddev *drop database*": "ask",
            "ddev *DROP TABLE*": "ask",
            "ddev *drop table*": "ask",
            "ddev *TRUNCATE*": "ask",
            "ddev *truncate*": "ask",
            "ddev *DELETE FROM*": "ask",
            "ddev *delete from*": "ask",
            "ddev delete *": "ask",
            "ddev import-db *": "ask",
            "ddev export-db *": "ask",
            "ddev snapshot *restore*": "ask",
            "ddev stop --remove-data*": "ask",
            "ddev poweroff *": "ask",
            "ddev exec cat *": "ask",
            "cat *": "ask"
        },
        "external_directory": "ask"
    }
}
