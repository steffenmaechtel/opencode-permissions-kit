{
    "$schema": "https://opencode.ai/config.json",
    // opencode permissions kit — default permission template
    // Bash is ask-by-default ("*": "ask"): every bash command prompts unless
    // explicitly allowlisted or denied below. The long ask-blacklist of the
    // early templates is gone — the default IS ask — so only an allowlist and
    // a hard denylist remain. No broad ask rules means an "always allow"
    // approval can never override a deny rule either.
    // NOTE: opencode's "always allow" approvals are only per-session (not
    // persisted), so extend the allowlist below as you go.

    "share": "disabled",
    // Auto-update is disabled on purpose: the binary is root-owned and
    // opencode runs as an unprivileged user, so self-update cannot work
    // behind the wrapper. Upgrade via: sudo update.sh --binary
    "autoupdate": false,
    "permission": {
        "read": {
            "*": "allow",
            // TYPO3
            "*additional.php": "deny",
            "*settings.php": "deny",
            // TYPO3 Legacy
            "*LocalConfiguration.php": "deny",
            "*AdditionalConfiguration.php": "deny",
            // Misc
            "*README.md": "deny",
            // README.txt is "ask" (not deny): ddev reads its command docs from
            // .ddev/commands/<svc>/README.txt at start, and a filesystem ACL
            // deny breaks ddev. "ask" keeps the soft prompt for the agent
            // without a hard ACL.
            "*README.txt": "ask",
            "*.sql.gz": "deny",
            "*auth.json": "deny",
            // ".env*" catches .env, .env.local, .env.example AND foo.env
            "*.env*": "deny",
            // Private Keys
            "*id_rsa*": "deny",
            "*id_ed25519*": "deny",
            "*.pem": "deny",
            // WordPress
            "*wp-config.php": "deny",
            // Legacy Projects
            // "*config.php" also covers "wp-config.php" and "myconfig.php"
            "*conf.php": "deny",
            "*config.php": "deny",
            //SECURE_GIT: ".git/config": "deny",
            //SECURE_GIT: "**/.git/config": "deny",
            "*config/database.php": "deny"
        },
        "edit": {
            "*": "allow",
            // TYPO3
            "*additional.php": "deny",
            "*settings.php": "deny",
            // TYPO3 Legacy
            "*LocalConfiguration.php": "deny",
            "*AdditionalConfiguration.php": "deny",
            // Misc
            "*README.md": "deny",
            // README.txt is "ask" (not deny): ddev reads its command docs from
            // .ddev/commands/<svc>/README.txt at start, and a filesystem ACL
            // deny breaks ddev. "ask" keeps the soft prompt for the agent
            // without a hard ACL.
            "*README.txt": "ask",
            "*.sql.gz": "deny",
            "*auth.json": "deny",
            // ".env*" catches .env, .env.local, .env.example AND foo.env
            "*.env*": "deny",
            // Private Keys
            "*id_rsa*": "deny",
            "*id_ed25519*": "deny",
            "*.pem": "deny",
            // WordPress
            "*wp-config.php": "deny",
            // Legacy Projects
            // "*config.php" also covers "wp-config.php" and "myconfig.php"
            "*conf.php": "deny",
            "*config.php": "deny",
            //SECURE_GIT: ".git/config": "deny",
            //SECURE_GIT: "**/.git/config": "deny",
            "*config/database.php": "deny"
        },
        "bash": {
            // DEFAULT-ASK: every bash command prompts unless explicitly
            // allowlisted or denied below. Last matching rule wins.
            "*": "ask",
            // ALLOW — provably harmless, read-only commands. Keep this list
            // tight: never allow prefixes with destructive subcommands
            // (git *, find *, chmod *, rm *, ...). cat/git config stay ask —
            // they read file content via bash and would bypass the read
            // denies above.
            "ls *": "allow",
            "pwd": "allow",
            "whoami": "allow",
            "id *": "allow",
            "uname *": "allow",
            "date *": "allow",
            "df *": "allow",
            "du *": "allow",
            "git status *": "allow",
            "git diff *": "allow",
            "git log *": "allow",
            // SYSTEM PROTECTION — destructive system commands, never allow.
            // Must come AFTER the allow rules: opencode applies the LAST
            // matching rule, so these override any broader allow above.
            "rm -rf /*": "deny",
            ">: /dev/sd*": "deny",
            "dd if=/dev/zero*": "deny",
            "dd of=/dev/sd*": "deny",
            "dd if=/dev/urandom of=/*": "deny",
            "mkfs*": "deny",
            "mkswap*": "deny",
            "swapon*": "deny",
            "fsck*": "deny",
            "chmod 777 /*": "deny",
            "chmod -R 777 /*": "deny",
            "chown -R * /*": "deny",
            "chgrp -R * /*": "deny",
            "mount *": "deny",
            "> /etc/*": "deny",
            "shred /*": "deny",
            // CONTAINER TOOLS — docker/ddev can only be reached through the
            // wrapper sandbox (sudo opencode -g docker|ddev). opencode itself
            // must never run them directly. "docker *" also covers
            // "docker compose ..." and the bare "docker" command; the
            // hyphenated "docker-compose *" is a separate binary.
            "docker *": "deny",
            "docker-compose *": "deny",
            "sudo docker *": "deny",
            "sudo docker-compose *": "deny",
            "ddev *": "deny",
            "sudo ddev *": "deny"
        },
        "external_directory": "ask"
    }
}
