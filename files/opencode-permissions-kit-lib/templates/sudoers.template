# opencode permissions kit — sudoers rule
# Deployed to /etc/opencode-permissions-kit/sudoers, symlinked as
# /etc/sudoers.d/opencode-permissions-kit. DEFAULT_USER is replaced at
# install time with the actual username.
#
# Soft protection model (internal/records/ddev-working.md): the wrapper execs
# opencode as the 'opencode' user against a rootless container backend —
# no supplementary docker group, no RunAs-developer ddev delegation, no
# root-side ACL helper. The opencode binary itself stays in the deny list,
# so this wrapper rule is the only path to run it.

# Preserve the rootless socket env across `sudo -u opencode`: the wrapper
# exports DOCKER_HOST (+XDG_RUNTIME_DIR) before the exec and sudo's env
# reset would drop them otherwise. OPENCODE_SERVER_PASSWORD and
# OPENCODE_SERVER_USERNAME stay too, so headless `opencode serve`
# (third-party UIs like OpenChamber, which pass the password they generate
# from --ui-password) does not silently lose its authentication — the
# username is the Basic-auth counterpart (server/auth.ts, default
# "opencode"). Browser commands (`ddev launch` & co.) need no extra
# variable anymore: their URLs are read from `ddev describe -j`
# (ddev/ddev#8771).
#
# Deliberately NOT kept: every other OPENCODE_* variable. Agent-side
# config (OPENCODE_CONFIG*, OPENCODE_AUTH_CONTENT, OPENCODE_API_KEY,
# OPENCODE_PERMISSION, OPENCODE_EXPERIMENTAL_*, OPENCODE_DISABLE_*, ...)
# belongs to the opencode user's own environment — env_reset is the
# protection here, keeping any of them would let the calling shell
# override agent config/permissions per invocation.
Defaults env_keep += "DOCKER_HOST XDG_RUNTIME_DIR OPENCODE_SERVER_PASSWORD OPENCODE_SERVER_USERNAME"

# Base RunAs: the wrapper always execs opencode as the opencode user.
DEFAULT_USER ALL=(opencode) NOPASSWD: /usr/local/lib/opencode-permissions-kit/bin/opencode *

# Rootless socket reachability: the wrapper probes the docker-rootless /
# podman-rootless socket from the opencode user's own context, because the
# runtime dir (/run/user/<uid>) is mode 700 opencode:opencode and a
# developer-running wrapper cannot stat it. Gated to the kit's socket-check
# helper only (it does nothing but `test -S`) — no arbitrary command execution.
DEFAULT_USER ALL=(opencode)  NOPASSWD: /usr/local/lib/opencode-permissions-kit/bin/socket-check *

# Headless serve working-directory probe: third-party UIs (OpenChamber) spawn
# `opencode serve` with the developer's $HOME as cwd — unreadable for the
# opencode user by design (UID separation), which turns every config load for
# that directory into HTTP 500. The wrapper probes readability from the
# opencode user's own context and falls back to a readable projects root.
# Gated to the kit's cwd-check helper only (it does nothing but stat the
# directory and print readable/unreadable) — no arbitrary command execution.
DEFAULT_USER ALL=(opencode)  NOPASSWD: /usr/local/lib/opencode-permissions-kit/bin/cwd-check *

# ddev always runs as the opencode user (internal/records/ddev-working.md §7):
# the developer's `ddev` shell function (ddev-terminal.sh, hooked into
# .bashrc/.zshrc/.profile) execs this helper via sudo, so the terminal and
# the agent share one ddev home + one rootless daemon. The helper is gated
# to this exact path, re-sets HOME/XDG_RUNTIME_DIR/DOCKER_HOST for the
# opencode user, and only ever execs the real ddev binary.
DEFAULT_USER ALL=(opencode)  NOPASSWD: /usr/local/lib/opencode-permissions-kit/bin/ddev-as-opencode *

# Git heal hooks (issue #671): the developer-side post-merge /
# post-checkout / post-rewrite / post-index-change hooks (activated by
# `opk git-heal on` through the developer's global core.hooksPath)
# re-pin .git/index and .git/HEAD to the opencode user after a
# developer git operation flipped their ownership (git writes both via
# lock+rename, so ownership floats with the last writer; under the
# sticky .git of the #651 heal the agent can never re-take it itself).
# RunAs root by design -- only chown can heal -- but narrow by
# construction: the script allowlists kit-managed project roots
# (projects.conf), realpath-rechecks the gitdir, verifies the gitdir
# shape (HEAD + objects/), skips symlinked and hardlinked operands,
# and changes nothing but the ownership of the measured operand set
# (the heal script's header carries the list: index, HEAD, ORIG_HEAD,
# REBASE_HEAD, packed-refs and the conflict pseudo-refs, each only
# when present). Without `opk git-heal on` nothing ever invokes it.
DEFAULT_USER ALL=(root) NOPASSWD: /usr/local/lib/opencode-permissions-kit/git-heal/heal-index-head *
