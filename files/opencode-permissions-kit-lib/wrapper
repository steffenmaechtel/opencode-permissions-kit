#!/bin/sh
# opencode permissions kit — Wrapper
# This file is deployed to /usr/local/bin/opencode by install.sh.
# It ensures opencode always runs as the dedicated 'opencode' user.
#
# Soft protection model (docs/design/DDEV-WORKING.md): the kit does NOT
# mirror opencode.jsonc deny rules into Linux ACLs. File permissions are
# enforced by opencode's own permission layer only. The wrapper's job is
# UID separation: validate the project dir, detect container-tool opt-in,
# and exec the binary as 'opencode' against its rootless backend.
# `opencode serve` takes a headless path (see SERVE_MODE below): third-party
# UIs like OpenChamber spawn the server non-interactively.
set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
NC='\033[0m'

PROJECTS_CONF="/etc/opencode-permissions-kit/projects.conf"

INSTALL_CONF="/etc/opencode-permissions-kit/install.conf"
VERSION="0.0.0"
if [ -f "$INSTALL_CONF" ]; then
    . "$INSTALL_CONF"
fi

# Container backend: docker-rootless or podman-rootless only. Unknown/missing
# values disable container tools for the session; the wrapper never falls
# back to a root-equivalent path.
CONTAINER_BACKEND="${CONTAINER_BACKEND:-}"
case "$CONTAINER_BACKEND" in
    docker-rootless|podman-rootless) ;;
    *) CONTAINER_BACKEND="" ;;
esac

# Headless serve mode. Third-party UIs (OpenChamber, ...) spawn
# `opencode serve --hostname <h> --port <p>` non-interactively: stdin is
# /dev/null and stdout is parsed for the "opencode server listening on
# <url>" line. Banner and prompts break that twice over — extra stdout
# noise for the parser, and `read` hitting EOF would make set -e kill
# the wrapper before the exec. Serve mode therefore prints nothing on
# stdout, reports diagnostics on stderr, skips the project-dir check
# (the server accepts sessions per client request; the soft layer —
# global + per-project opencode.jsonc — still applies to every session),
# and resolves container tools silently.
SERVE_MODE=false
if [ "${1:-}" = "serve" ]; then SERVE_MODE=true; fi

# Wrapper diagnostics: interactive starts print to the terminal, serve
# mode redirects to stderr so stdout carries only opencode's own output.
# printf '%b' (not echo) so the \033 color escapes render identically
# under dash and bash. An empty argument prints a blank separator line.
note() {
    _fd=1
    [ "$SERVE_MODE" = true ] && _fd=2
    if [ -n "$1" ]; then
        printf '  %b\n' "$1" >&"$_fd"
    else
        printf '\n' >&"$_fd"
    fi
}

CWD=$(pwd)
VALID=false
if [ -f "$PROJECTS_CONF" ]; then
    while IFS= read -r root; do
        [ -z "$root" ] && continue
        [ ! -d "$root" ] && continue
        root_clean="${root%/}"
        if [ "$CWD" = "$root_clean" ] || [ "${CWD#$root_clean/}" != "$CWD" ]; then
            VALID=true
            break
        fi
    done < "$PROJECTS_CONF"
fi

if [ "$VALID" != true ] && [ "$SERVE_MODE" != true ]; then
    # Version/help queries carry no project context — answer them from the
    # real binary instead of refusing. The official opencode installer
    # probes `opencode --version` from $HOME while the kit installs; the
    # refusal mid-install confused users ("ERROR: opencode cannot be
    # started here"). From a VALID directory the normal bannered path
    # below still applies.
    case "${1:-}" in
        --version|-v|-h|--help)
            exec /usr/bin/sudo -u opencode /usr/local/lib/opencode-permissions-kit/bin/opencode "$@"
            ;;
    esac
    echo ""
    echo "  ${RED}ERROR: opencode cannot be started here${NC}"
    echo "  ${YELLOW}$CWD${NC} is not a valid project directory."
    echo ""
    echo "  Valid project directories:"
    if [ -f "$PROJECTS_CONF" ] && [ -s "$PROJECTS_CONF" ]; then
        count=0
        while IFS= read -r root; do
            [ -z "$root" ] && continue
            count=$((count + 1))
            if [ "$count" -gt 10 ]; then
                echo "  ... and more"
                break
            fi
            printf "  - %s\n" "$root"
        done < "$PROJECTS_CONF"
    else
        echo "  (none configured — run install.sh first)"
    fi
    echo ""
    exit 1
fi

if [ "$SERVE_MODE" != true ]; then
    echo ""
    echo "  ${GREEN}SECURED BY opencode permissions kit ($VERSION)${NC}"
    echo "  ${CYAN}@steffenmaechtel/opencode-permissions-kit${NC}"
    echo ""
fi

# Self-check: a self-installed opencode binary (official installer re-run or
# PATH re-add) would shadow the wrapper in new shells, and tools may call the
# absolute path of the real binary. Warn (but keep running) when one is present.
SHADOW="$HOME/.opencode/bin/opencode"
if [ -e "$SHADOW" ] && { [ ! -L "$SHADOW" ] || [ "$(readlink -f "$SHADOW" 2>/dev/null || echo "$SHADOW")" != "/usr/local/lib/opencode-permissions-kit/wrapper" ]; }; then
    note "${YELLOW}WARNING: self-installed opencode detected at $SHADOW${NC}"
    note "${YELLOW}New shells would run it instead of this wrapper. Fix: rm -rf $SHADOW${NC}"
    note ""
fi
RESOLVED=$(command -v opencode 2>/dev/null || true)
if [ -n "$RESOLVED" ] && [ "$RESOLVED" != "/usr/local/bin/opencode" ]; then
    note "${YELLOW}WARNING: 'opencode' on this PATH resolves to $RESOLVED, not the kit wrapper.${NC}"
    note ""
fi

# WSL2 exposure check: the drvfs /mnt/c mount runs with the Windows session
# token — NTFS ACLs do not distinguish WSL users, so a world-readable mount
# lets the agent read the whole Windows profile (.ssh, NTUSER.DAT, browser
# data). Warn on EVERY start until the restriction is applied.
if [ -d /mnt/c ]; then
    mnt_mode=$(stat -c %a /mnt/c 2>/dev/null || echo "")
    if [ -n "$mnt_mode" ] && [ $((0$mnt_mode & 0004)) -ne 0 ]; then
        if grep -q '^options *=.*dmask' /etc/wsl.conf 2>/dev/null; then
            note "${YELLOW}WARNING: /mnt/c restriction configured but PENDING (mode $mnt_mode).${NC}"
            note "${YELLOW}Run 'wsl --shutdown' from Windows and reopen the distro — until then${NC}"
            note "${YELLOW}the agent can read your Windows profile via /mnt/c.${NC}"
        else
            note "${YELLOW}WARNING: /mnt/c is world-readable (mode $mnt_mode) — the agent can read${NC}"
            note "${YELLOW}your whole Windows profile (.ssh, browser data). Fix in /etc/wsl.conf:${NC}"
            note "${YELLOW}  [automount]${NC}"
            note "${YELLOW}  enabled = true${NC}"
            note "${YELLOW}  options = \"uid=<uid>,gid=<gid>,dmask=027,fmask=037\"${NC}"
            note "${YELLOW}then 'wsl --shutdown' from Windows (install.sh can apply this for you).${NC}"
        fi
        note ""
    fi
fi

# Detect container tools (docker/ddev) explicitly enabled by the project
# config. Any enabled tool means "enable container tools for this session"
# — the rootless backend decides the actual mechanism.
CONTAINER_REQUESTED=false
CONTAINER_AUTO=false
PROJECT_CONFIG=""
if [ -f "./opencode.jsonc" ]; then PROJECT_CONFIG="./opencode.jsonc"
elif [ -f "./opencode.json" ]; then PROJECT_CONFIG="./opencode.json"; fi
if [ -n "$PROJECT_CONFIG" ]; then
    PROJECT_TOOLS=$(python3 /usr/local/lib/opencode-permissions-kit/jsonc-parser.py --tools "$PROJECT_CONFIG" 2>/dev/null || true)
    if [ -n "$PROJECT_TOOLS" ]; then
        note "${CYAN}Container tools enabled by this project:${NC}"
        if [ "$SERVE_MODE" = true ]; then
            printf '%s\n' "$PROJECT_TOOLS" | sed 's/^/    - /' >&2
        else
            printf '%s\n' "$PROJECT_TOOLS" | sed 's/^/    - /'
        fi
        note ""
        CONTAINER_REQUESTED=true
        CONTAINER_AUTO=true
    fi
fi

# Serve mode requests container tools silently: a server process serves
# many projects, so there is no single project opt-in to confirm and no
# terminal to confirm on. This stays inside the soft model — whether a
# session may use docker/ddev is still decided per session by the
# global and per-project opencode.jsonc permission rules.
if [ "$SERVE_MODE" = true ]; then
    CONTAINER_REQUESTED=true
    CONTAINER_AUTO=false
fi

# Resolve the container mechanism for the configured backend. Produces one of:
#   CONTAINER_DOCKER_HOST   -> sudo -u opencode with DOCKER_HOST exported
#                              (docker-rootless socket, or podman-rootless when
#                               OPENCODE_PODMAN_SOCKET is set for docker-CLI compat)
#   CONTAINER_PODMAN=true   -> sudo -u opencode, no DOCKER_HOST (podman-CLI path,
#                              daemonless per §9.8 — podman run needs no socket)
#   all empty               -> no container tools this session
# Probe whether a rootless backend socket is reachable. The sockets live in the
# opencode user's runtime dir (/run/user/<uid>, mode 700 opencode:opencode), so
# a wrapper running as the developer cannot stat them directly. Try directly
# first (works when the wrapper runs as root or as the opencode user itself, or
# the socket sits somewhere traversable); otherwise re-probe as the opencode
# user — the context that will actually connect — via the kit's NOPASSWD
# socket-check.sh rule. Accepts "unix://..." or a plain path.
sock_reachable() {
    [ -n "$1" ] || return 1
    sock="$1"
    case "$sock" in unix://*) sock="${sock#unix://}";; esac
    [ -S "$sock" ] 2>/dev/null && return 0
    /usr/bin/sudo -u opencode /usr/local/lib/opencode-permissions-kit/bin/socket-check.sh "$sock" 2>/dev/null
}

CONTAINER_DOCKER_HOST=""
CONTAINER_XDG=""
CONTAINER_PODMAN=""
CONTAINER_LABEL=""
if [ "$CONTAINER_REQUESTED" = true ]; then
    if [ -z "$CONTAINER_BACKEND" ]; then
        note "${RED}WARNING: no rootless container backend configured.${NC}"
        note "${YELLOW}Running WITHOUT container tools. Re-run install.sh to provision one.${NC}"
        note ""
        CONTAINER_REQUESTED=false
        CONTAINER_AUTO=false
    else
        CONTAINER_LABEL="the $CONTAINER_BACKEND backend"
        case "$CONTAINER_BACKEND" in
            docker-rootless)
                # Requires the per-user dockerd socket. Never fall back to a
                # root-equivalent docker group — warn loudly and run without.
                sock_host="${OPENCODE_DOCKER_HOST:-}"
                if sock_reachable "$sock_host"; then
                    CONTAINER_DOCKER_HOST="$sock_host"
                    CONTAINER_XDG="/run/user/$(id -u opencode 2>/dev/null || echo 0)"
                else
                    note "${RED}WARNING: docker-rootless socket not reachable (${sock_host:-unset}).${NC}"
                    note "${YELLOW}Running WITHOUT container tools — not downgrading to a root-equivalent path.${NC}"
                    note ""
                    CONTAINER_REQUESTED=false
                    CONTAINER_AUTO=false
                fi
                ;;
            podman-rootless)
                # Default: podman is daemonless — `podman run` needs no socket
                # and no DOCKER_HOST (§9.8 podman-CLI path). Optional:
                # OPENCODE_PODMAN_SOCKET enables docker-CLI compat (point a
                # `docker` CLI at the podman socket); when set, verify
                # reachability like the docker-rootless path.
                sock_host="${OPENCODE_PODMAN_SOCKET:-}"
                if [ -n "$sock_host" ]; then
                    if sock_reachable "$sock_host"; then
                        CONTAINER_DOCKER_HOST="$sock_host"
                        CONTAINER_XDG="/run/user/$(id -u opencode 2>/dev/null || echo 0)"
                    else
                        note "${RED}WARNING: podman-rootless socket not reachable ($sock_host).${NC}"
                        note "${YELLOW}Running WITHOUT container tools — not downgrading to a root-equivalent path.${NC}"
                        note ""
                        CONTAINER_REQUESTED=false
                        CONTAINER_AUTO=false
                    fi
                elif command -v podman >/dev/null 2>&1; then
                    CONTAINER_PODMAN=true
                else
                    note "${RED}WARNING: podman-rootless backend selected but 'podman' is not installed.${NC}"
                    note "${YELLOW}Running WITHOUT container tools — not downgrading to a root-equivalent path.${NC}"
                    note ""
                    CONTAINER_REQUESTED=false
                    CONTAINER_AUTO=false
                fi
                ;;
        esac
    fi
fi

if [ "$CONTAINER_AUTO" = true ]; then
    # Prompt convention: docs/design/conventions.md — [Y/n] default capital,
    # Enter accepts, y/yes/n/no case-insensitive.
    printf "  Run opencode with %s? [Y/n] " "$CONTAINER_LABEL"
    read answer
    _ans=$(printf '%s' "$answer" | tr '[:upper:]' '[:lower:]')
    case "$_ans" in
        n|no)
            CONTAINER_DOCKER_HOST=""
            CONTAINER_XDG=""
            CONTAINER_PODMAN=""
            ;;
    esac
    if [ -n "$CONTAINER_DOCKER_HOST" ] || [ "$CONTAINER_PODMAN" = true ]; then
        echo ""
        printf "  ${GREEN}opencode will run with %s.${NC}\n" "$CONTAINER_LABEL"
        echo ""
    fi
else
    if [ "$SERVE_MODE" != true ]; then
        printf "  Press Enter to start opencode..."
        read _
    elif [ -n "$CONTAINER_DOCKER_HOST" ] || [ "$CONTAINER_PODMAN" = true ]; then
        printf '  %b\n' "${GREEN}opencode serve: container tools attached via $CONTAINER_LABEL.${NC}" >&2
    fi
fi

# Rootless: pass the per-user socket through sudo's env reset via env_keep.
# podman-CLI path (daemonless): no DOCKER_HOST, no supplementary group.
# Containers run as the opencode host UID either way.
if [ -n "$CONTAINER_DOCKER_HOST" ]; then
    export DOCKER_HOST="$CONTAINER_DOCKER_HOST"
    [ -n "$CONTAINER_XDG" ] && export XDG_RUNTIME_DIR="$CONTAINER_XDG"
    exec /usr/bin/sudo -u opencode /usr/local/lib/opencode-permissions-kit/bin/opencode "$@"
fi
exec /usr/bin/sudo -u opencode /usr/local/lib/opencode-permissions-kit/bin/opencode "$@"
