#!/bin/sh
# opencode permissions kit — Wrapper
# This file is deployed to /usr/local/bin/opencode by install.sh.
# It ensures opencode always runs as the dedicated 'opencode' user.
# Pass `-g docker` (or `--gid docker`) to run opencode with the docker group so
# container commands work inside the sandbox. Projects that explicitly enable
# docker/ddev in their opencode.jsonc trigger this automatically (confirmed
# before start).
set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
NC='\033[0m'

PROJECTS_CONF="/etc/opencode-permissions-kit/projects.conf"
[ -f "$PROJECTS_CONF" ] || PROJECTS_CONF="/etc/opencode/projects.conf"

INSTALL_CONF="/etc/opencode-permissions-kit/install.conf"
[ -f "$INSTALL_CONF" ] || INSTALL_CONF="/etc/opencode-permissions-kit/setup.conf"
[ -f "$INSTALL_CONF" ] || INSTALL_CONF="/etc/opencode/install.conf"
[ -f "$INSTALL_CONF" ] || INSTALL_CONF="/etc/opencode/setup.conf"
VERSION="0.0.0"
if [ -f "$INSTALL_CONF" ]; then
    . "$INSTALL_CONF"
fi

CWD=$(pwd)
VALID=false
if [ -f "$PROJECTS_CONF" ]; then
    while IFS= read -r root; do
        [ -z "$root" ] && continue
        [ ! -d "$root" ] && continue
        root_clean="${root%/}"
        if [ "$CWD" = "$root_clean" ] || [ "${CWD#$root_clean/}" != "$CWD" ]; then
            VALID=true
            break
        fi
    done < "$PROJECTS_CONF"
fi

if [ "$VALID" != true ]; then
    echo ""
    echo "  ${RED}ERROR: opencode cannot be started here${NC}"
    echo "  ${YELLOW}$CWD${NC} is not a valid project directory."
    echo ""
    echo "  Valid project directories:"
    if [ -f "$PROJECTS_CONF" ] && [ -s "$PROJECTS_CONF" ]; then
        count=0
        while IFS= read -r root; do
            [ -z "$root" ] && continue
            count=$((count + 1))
            if [ "$count" -gt 10 ]; then
                echo "  ... and more"
                break
            fi
            printf "  - %s\n" "$root"
        done < "$PROJECTS_CONF"
    else
        echo "  (none configured — run install.sh first)"
    fi
    echo ""
    exit 1
fi

echo ""
echo "  ${GREEN}SECURED BY opencode permissions kit ($VERSION)${NC}"
echo "  ${CYAN}@steffenmaechtel/opencode-permissions-kit${NC}"
echo ""

# Parse -g/--gid: the kit's escalation channel for container groups.
CONTAINER_GROUP=""
CONTAINER_AUTO=false
prev=""
for arg in "$@"; do
    case "$prev" in
        -g|--gid)
            case "$arg" in
                docker|0|root)
                    CONTAINER_GROUP="docker"
                    ;;
                *)
                    echo ""
                    echo "  ${RED}ERROR: unsupported group '$arg'${NC}"
                    echo "  ${YELLOW}Supported: -g docker (runs opencode with the docker group).${NC}"
                    echo ""
                    exit 1
                    ;;
            esac
            ;;
    esac
    case "$arg" in
        -g|--gid) prev="$arg" ;;
        *) prev="" ;;
    esac
done

# Check for project-level allow overrides
PROJECT_CONFIG=""
if [ -f "./opencode.jsonc" ]; then PROJECT_CONFIG="./opencode.jsonc"
elif [ -f "./opencode.json" ]; then PROJECT_CONFIG="./opencode.json"; fi
if [ -n "$PROJECT_CONFIG" ]; then
    PROJECT_ALLOW=$(python3 /usr/local/lib/opencode-permissions-kit/jsonc-parser.py --allow "$PROJECT_CONFIG" 2>/dev/null || true)
    if [ -n "$PROJECT_ALLOW" ]; then
        echo "  ${YELLOW}WARNING: This project overrides global deny rules:${NC}"
        echo "$PROJECT_ALLOW" | sed 's/^/    - /'
        echo ""
    fi
fi

# Detect container tools (docker/ddev) explicitly enabled by the project config
# and run opencode with the docker group so they work inside the sandbox.
if [ -z "$CONTAINER_GROUP" ] && [ -n "$PROJECT_CONFIG" ]; then
    PROJECT_TOOLS=$(python3 /usr/local/lib/opencode-permissions-kit/jsonc-parser.py --tools "$PROJECT_CONFIG" 2>/dev/null || true)
    if [ -n "$PROJECT_TOOLS" ]; then
        echo "  ${CYAN}Container tools enabled by this project:${NC}"
        echo "$PROJECT_TOOLS" | sed 's/^/    - /'
        echo ""
        CONTAINER_GROUP="docker"
        CONTAINER_AUTO=true
    fi
fi

if [ -n "$CONTAINER_GROUP" ] && ! getent group "$CONTAINER_GROUP" >/dev/null 2>&1; then
    echo "  ${YELLOW}WARNING: group '$CONTAINER_GROUP' does not exist — running without container group.${NC}"
    echo ""
    CONTAINER_GROUP=""
fi

if [ "$CONTAINER_AUTO" = true ]; then
    printf "  Run opencode with the docker group? [Y/n] "
    read answer
    case "$answer" in
        n|N|no|No|NO) CONTAINER_GROUP="" ;;
    esac
    if [ -n "$CONTAINER_GROUP" ]; then
        echo ""
        echo "  ${GREEN}opencode will run with the docker group.${NC}"
        echo ""
    fi
else
    printf "  Press Enter to start opencode..."
    read _
fi

/usr/bin/sudo /usr/local/lib/opencode-permissions-kit/protect-projects.sh --cwd "$CWD"

# Stamp the launch CWD into the opencode process environment. sudo resets the
# env (and refuses `sudo VAR=value cmd` under the kit's restricted rule), so the
# var is exported and preserved via `Defaults env_keep` in the kit's sudoers.
# opencode's shells and any git they spawn inherit it, so git hooks can apply
# the project opencode.jsonc of the directory opencode was started in — not the
# git worktree root (which may be a nested repo).
export OPENCODE_LAUNCH_CWD="$CWD"
if [ -n "$CONTAINER_GROUP" ]; then
    exec /usr/bin/sudo -u opencode -g "$CONTAINER_GROUP" /usr/local/lib/opencode-permissions-kit/bin/opencode "$@"
else
    exec /usr/bin/sudo -u opencode /usr/local/lib/opencode-permissions-kit/bin/opencode "$@"
fi
