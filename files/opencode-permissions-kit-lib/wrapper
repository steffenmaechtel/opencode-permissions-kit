#!/bin/sh
# opencode permissions kit — Wrapper
# This file is deployed to /usr/local/bin/opencode by install.sh.
# It ensures opencode always runs as the dedicated 'opencode' user.
# Pass `-g docker` (or `--gid docker`) to run opencode with the docker group so
# container commands work inside the sandbox. Projects that explicitly enable
# docker/ddev in their opencode.jsonc trigger this automatically (confirmed
# before start).
set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
NC='\033[0m'

PROJECTS_CONF="/etc/opencode-permissions-kit/projects.conf"
[ -f "$PROJECTS_CONF" ] || PROJECTS_CONF="/etc/opencode/projects.conf"

INSTALL_CONF="/etc/opencode-permissions-kit/install.conf"
[ -f "$INSTALL_CONF" ] || INSTALL_CONF="/etc/opencode-permissions-kit/setup.conf"
[ -f "$INSTALL_CONF" ] || INSTALL_CONF="/etc/opencode/install.conf"
[ -f "$INSTALL_CONF" ] || INSTALL_CONF="/etc/opencode/setup.conf"
VERSION="0.0.0"
if [ -f "$INSTALL_CONF" ]; then
    . "$INSTALL_CONF"
fi

# Container backend (see docs/DOCKER-ROOTLESS.md). Recorded in install.conf by
# install.sh. Empty/unknown defaults to docker-group (the legacy behaviour) so
# existing installs keep working unchanged: the wrapper hands opencode the
# docker group via `-g docker`. docker-rootless / podman-rootless instead talk
# to a per-user socket owned by the opencode user, so the kit's hard ACL denies
# hold inside containers too — those run WITHOUT `-g` and set DOCKER_HOST.
CONTAINER_BACKEND="${CONTAINER_BACKEND:-docker-group}"
case "$CONTAINER_BACKEND" in
    docker-group|docker-rootless|podman-rootless) ;;
    *) CONTAINER_BACKEND="docker-group" ;;
esac

CWD=$(pwd)
VALID=false
if [ -f "$PROJECTS_CONF" ]; then
    while IFS= read -r root; do
        [ -z "$root" ] && continue
        [ ! -d "$root" ] && continue
        root_clean="${root%/}"
        if [ "$CWD" = "$root_clean" ] || [ "${CWD#$root_clean/}" != "$CWD" ]; then
            VALID=true
            break
        fi
    done < "$PROJECTS_CONF"
fi

if [ "$VALID" != true ]; then
    echo ""
    echo "  ${RED}ERROR: opencode cannot be started here${NC}"
    echo "  ${YELLOW}$CWD${NC} is not a valid project directory."
    echo ""
    echo "  Valid project directories:"
    if [ -f "$PROJECTS_CONF" ] && [ -s "$PROJECTS_CONF" ]; then
        count=0
        while IFS= read -r root; do
            [ -z "$root" ] && continue
            count=$((count + 1))
            if [ "$count" -gt 10 ]; then
                echo "  ... and more"
                break
            fi
            printf "  - %s\n" "$root"
        done < "$PROJECTS_CONF"
    else
        echo "  (none configured — run install.sh first)"
    fi
    echo ""
    exit 1
fi

echo ""
echo "  ${GREEN}SECURED BY opencode permissions kit ($VERSION)${NC}"
echo "  ${CYAN}@steffenmaechtel/opencode-permissions-kit${NC}"
echo ""

# Self-check: a self-installed opencode binary (official installer re-run or
# PATH re-add) would shadow the wrapper in new shells, and tools may call the
# absolute path of the real binary. Warn (but keep running) when one is present.
SHADOW="$HOME/.opencode/bin/opencode"
if [ -e "$SHADOW" ] && { [ ! -L "$SHADOW" ] || [ "$(readlink -f "$SHADOW" 2>/dev/null || echo "$SHADOW")" != "/usr/local/lib/opencode-permissions-kit/wrapper" ]; }; then
    echo "  ${YELLOW}WARNING: self-installed opencode detected at $SHADOW${NC}"
    echo "  ${YELLOW}New shells would run it instead of this wrapper. Fix: rm -rf $SHADOW${NC}"
    echo ""
fi
RESOLVED=$(command -v opencode 2>/dev/null || true)
if [ -n "$RESOLVED" ] && [ "$RESOLVED" != "/usr/local/bin/opencode" ]; then
    echo "  ${YELLOW}WARNING: 'opencode' on this PATH resolves to $RESOLVED, not the kit wrapper.${NC}"
    echo ""
fi

# Parse -g/--gid: the kit's escalation channel for container groups. The flag
# means "enable container tools for this session"; the configured backend decides
# HOW (docker group for docker-group, DOCKER_HOST for the rootless backends).
CONTAINER_REQUESTED=false
CONTAINER_AUTO=false
prev=""
for arg in "$@"; do
    case "$prev" in
        -g|--gid)
            case "$arg" in
                docker|0|root)
                    CONTAINER_REQUESTED=true
                    ;;
                *)
                    echo ""
                    echo "  ${RED}ERROR: unsupported group '$arg'${NC}"
                    echo "  ${YELLOW}Supported: -g docker (enables container tools via the configured backend).${NC}"
                    echo ""
                    exit 1
                    ;;
            esac
            ;;
    esac
    case "$arg" in
        -g|--gid) prev="$arg" ;;
        *) prev="" ;;
    esac
done

# Check for project-level allow overrides
PROJECT_CONFIG=""
if [ -f "./opencode.jsonc" ]; then PROJECT_CONFIG="./opencode.jsonc"
elif [ -f "./opencode.json" ]; then PROJECT_CONFIG="./opencode.json"; fi
if [ -n "$PROJECT_CONFIG" ]; then
    PROJECT_ALLOW=$(python3 /usr/local/lib/opencode-permissions-kit/jsonc-parser.py --allow "$PROJECT_CONFIG" 2>/dev/null || true)
    if [ -n "$PROJECT_ALLOW" ]; then
        echo "  ${YELLOW}WARNING: This project overrides global deny rules:${NC}"
        echo "$PROJECT_ALLOW" | sed 's/^/    - /'
        echo ""
    fi
fi

# Detect container tools (docker/ddev) explicitly enabled by the project config.
# Any enabled tool means "enable container tools for this session" — the backend
# (resolved below) decides the actual mechanism.
if [ "$CONTAINER_REQUESTED" = false ] && [ -n "$PROJECT_CONFIG" ]; then
    PROJECT_TOOLS=$(python3 /usr/local/lib/opencode-permissions-kit/jsonc-parser.py --tools "$PROJECT_CONFIG" 2>/dev/null || true)
    if [ -n "$PROJECT_TOOLS" ]; then
        echo "  ${CYAN}Container tools enabled by this project:${NC}"
        echo "$PROJECT_TOOLS" | sed 's/^/    - /'
        echo ""
        CONTAINER_REQUESTED=true
        CONTAINER_AUTO=true
    fi
fi

# Resolve the container mechanism for the configured backend. Produces one of:
#   CONTAINER_GROUP set     -> sudo -u opencode -g docker  (docker-group backend)
#   CONTAINER_DOCKER_HOST   -> sudo -u opencode with DOCKER_HOST exported
#                              (docker-rootless socket, or podman-rootless when
#                               OPENCODE_PODMAN_SOCKET is set for docker-CLI compat)
#   CONTAINER_PODMAN=true   -> sudo -u opencode, no DOCKER_HOST (podman-CLI path,
#                              daemonless per §9.8 — podman run needs no socket)
# all empty                 -> no container tools this session
CONTAINER_GROUP=""
CONTAINER_DOCKER_HOST=""
CONTAINER_XDG=""
CONTAINER_PODMAN=""
CONTAINER_LABEL=""
if [ "$CONTAINER_REQUESTED" = true ]; then
    case "$CONTAINER_BACKEND" in
        docker-rootless)
            CONTAINER_LABEL="the docker-rootless backend"
            # Requires the per-user dockerd socket. Never silently fall back to
            # -g docker (root-equivalent); warn loudly and run without instead.
            sock_host="${OPENCODE_DOCKER_HOST:-}"
            sock="$sock_host"
            case "$sock" in unix://*) sock="${sock#unix://}";; esac
            if [ -n "$sock" ] && [ -S "$sock" ]; then
                CONTAINER_DOCKER_HOST="$sock_host"
                CONTAINER_XDG="/run/user/$(id -u opencode 2>/dev/null || echo 0)"
            else
                echo "  ${RED}WARNING: docker-rootless socket not reachable (${sock_host:-unset}).${NC}"
                echo "  ${YELLOW}Running WITHOUT container tools — not downgrading to -g docker (root-equivalent).${NC}"
                echo ""
                CONTAINER_REQUESTED=false
                CONTAINER_AUTO=false
            fi
            ;;
        podman-rootless)
            CONTAINER_LABEL="the podman-rootless backend"
            # Default: podman is daemonless — `podman run` needs no socket and no
            # DOCKER_HOST (§9.8 podman-CLI path). Verify podman is installed.
            # Optional: OPENCODE_PODMAN_SOCKET enables docker-CLI compat (point a
            # `docker` CLI at the podman socket); when set, verify reachability
            # like the docker-rootless path.
            sock_host="${OPENCODE_PODMAN_SOCKET:-}"
            if [ -n "$sock_host" ]; then
                sock="$sock_host"
                case "$sock" in unix://*) sock="${sock#unix://}";; esac
                if [ -S "$sock" ]; then
                    CONTAINER_DOCKER_HOST="$sock_host"
                    CONTAINER_XDG="/run/user/$(id -u opencode 2>/dev/null || echo 0)"
                else
                    echo "  ${RED}WARNING: podman-rootless socket not reachable ($sock_host).${NC}"
                    echo "  ${YELLOW}Running WITHOUT container tools — not downgrading to -g docker (root-equivalent).${NC}"
                    echo ""
                    CONTAINER_REQUESTED=false
                    CONTAINER_AUTO=false
                fi
            elif command -v podman >/dev/null 2>&1; then
                CONTAINER_PODMAN=true
            else
                echo "  ${RED}WARNING: podman-rootless backend selected but 'podman' is not installed.${NC}"
                echo "  ${YELLOW}Running WITHOUT container tools — not downgrading to -g docker (root-equivalent).${NC}"
                echo ""
                CONTAINER_REQUESTED=false
                CONTAINER_AUTO=false
            fi
            ;;
        docker-group|*)
            CONTAINER_LABEL="the docker group"
            if ! getent group docker >/dev/null 2>&1; then
                echo "  ${YELLOW}WARNING: group 'docker' does not exist — running without container group.${NC}"
                echo ""
                CONTAINER_REQUESTED=false
                CONTAINER_AUTO=false
            else
                CONTAINER_GROUP="docker"
            fi
            ;;
    esac
fi

if [ "$CONTAINER_AUTO" = true ]; then
    printf "  Run opencode with %s? [Y/n] " "$CONTAINER_LABEL"
    read answer
    case "$answer" in
        n|N|no|No|NO)
            CONTAINER_GROUP=""
            CONTAINER_DOCKER_HOST=""
            CONTAINER_XDG=""
            CONTAINER_PODMAN=""
            ;;
    esac
    if [ -n "$CONTAINER_GROUP" ] || [ -n "$CONTAINER_DOCKER_HOST" ] || [ "$CONTAINER_PODMAN" = true ]; then
        echo ""
        printf "  ${GREEN}opencode will run with %s.${NC}\n" "$CONTAINER_LABEL"
        echo ""
    fi
else
    printf "  Press Enter to start opencode..."
    read _
fi

/usr/bin/sudo /usr/local/lib/opencode-permissions-kit/protect-projects.sh --cwd "$CWD"

# Stamp the launch CWD into the opencode process environment. sudo resets the
# env (and refuses `sudo VAR=value cmd` under the kit's restricted rule), so the
# var is exported and preserved via `Defaults env_keep` in the kit's sudoers.
# opencode's shells and any git they spawn inherit it, so git hooks can apply
# the project opencode.jsonc of the directory opencode was started in — not the
# git worktree root (which may be a nested repo).
export OPENCODE_LAUNCH_CWD="$CWD"
if [ -n "$CONTAINER_GROUP" ]; then
    exec /usr/bin/sudo -u opencode -g "$CONTAINER_GROUP" /usr/local/lib/opencode-permissions-kit/bin/opencode "$@"
elif [ -n "$CONTAINER_DOCKER_HOST" ]; then
    # Rootless: pass the per-user socket through sudo's env reset via env_keep.
    export DOCKER_HOST="$CONTAINER_DOCKER_HOST"
    [ -n "$CONTAINER_XDG" ] && export XDG_RUNTIME_DIR="$CONTAINER_XDG"
    exec /usr/bin/sudo -u opencode /usr/local/lib/opencode-permissions-kit/bin/opencode "$@"
elif [ "$CONTAINER_PODMAN" = true ]; then
    # podman-CLI path (daemonless): no DOCKER_HOST, no -g. Containers run as the
    # opencode host UID, so the kit's u:opencode:--- ACL denies hold inside
    # bind-mounted containers too (see docs/DOCKER-ROOTLESS.md §9.1).
    exec /usr/bin/sudo -u opencode /usr/local/lib/opencode-permissions-kit/bin/opencode "$@"
else
    exec /usr/bin/sudo -u opencode /usr/local/lib/opencode-permissions-kit/bin/opencode "$@"
fi
