#!/bin/sh
# opencode permissions kit -- bin/opencode-as-opencode
# This file is deployed to /usr/local/bin/opencode by install.sh (symlink
# to /usr/local/lib/opencode-permissions-kit/bin/opencode-as-opencode).
# It ensures opencode always runs as the dedicated 'opencode' user —
# the wrapper's name follows the bin/ddev-as-opencode pattern ("run X as
# the opencode user").
#
# Soft protection model (internal/records/ddev-working.md): the kit does NOT
# mirror opencode.jsonc deny rules into Linux ACLs. File permissions are
# enforced by opencode's own permission layer only. The wrapper's job is
# UID separation: validate the project dir, detect container-tool opt-in,
# and exec the binary as 'opencode' against its rootless backend.
# `opencode serve` and friends take a headless path (see HEADLESS below):
# third-party UIs like OpenChamber spawn the server non-interactively, and
# orchestrators parse `opencode run --format json` output.
#
# Decomposed shape (#346 wave shape, #449): the executable sections
# live in sh/as-opencode-core.sh, sourced below; this entry keeps the
# globals, the pairing guard, the section sequence, the --standalone
# arg rewrite (its top-level `set --` cannot live in a function) and
# the final exec.
set -e

# Colors resolve to REAL bytes once (printf, not echo -e); off for
# NO_COLOR / non-tty, same rule as sh/ui.sh and uninstall.sh
# (0.0.39e C10/C12; guard added per 0.0.39m C1).
if [ -n "${NO_COLOR:-}" ] || [ ! -t 1 ]; then
    RED=''
    GREEN=''
    CYAN=''
    YELLOW=''
    NC=''
else
    RED=$(printf '\033[0;31m')
    GREEN=$(printf '\033[0;32m')
    CYAN=$(printf '\033[0;36m')
    YELLOW=$(printf '\033[0;33m')
    NC=$(printf '\033[0m')
fi

PROJECTS_CONF="/etc/opencode-permissions-kit/projects.conf"

INSTALL_CONF="/etc/opencode-permissions-kit/install.conf"
VERSION="0.0.0"
if [ -f "$INSTALL_CONF" ]; then
    . "$INSTALL_CONF"
fi

# Container backend: docker-rootless or podman-rootless only. Unknown/missing
# values disable container tools for the session; the wrapper never falls
# back to a root-equivalent path.
CONTAINER_BACKEND="${CONTAINER_BACKEND:-}"
case "$CONTAINER_BACKEND" in
    docker-rootless | podman-rootless) ;;
    *) CONTAINER_BACKEND="" ;;
esac

# --- section lib (#346 wave shape, #449) -------------------------------------
# The wrapper's executable sections live in sh/as-opencode-core.sh,
# resolved through the wrapper's own real path (the bin/opk
# openchamber-core pattern, #447 -- no deployed-path fallback: a
# deployed run resolves the deployed lib through its own real path, a
# checkout run the checkout's lib, a symlinked invocation through the
# full readlink chain). A missing lib is a broken kit (the #165
# class): loud error, never a silent run on.
SELF="$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")"
LIBDIR="$(cd "$(dirname "$SELF")/.." && pwd -P)"
WRAPPER_CORE="$LIBDIR/sh/as-opencode-core.sh"
if [ -f "$WRAPPER_CORE" ]; then
    # shellcheck disable=SC1090  # resolved above
    . "$WRAPPER_CORE"
else
    echo "error: as-opencode-core.sh not found (expected $WRAPPER_CORE) — is the kit installed?" >&2
    exit 1
fi

# Pairing guard (#413, the status.sh/doctor.sh pattern): a
# version-skewed entry/lib pairing (a lib missing one renamed or
# newly-added section) refuses loud BEFORE any section runs -- under
# set -e a missing section would die mid-run with a bare "not found",
# after partial output. The list covers EVERY function the lib defines
# (#453 a A2/B1/C5): sections AND helpers -- a helper name that went
# missing passes a section-only guard and dies mid-run (or silently
# degrades where its call sits in a condition), the exact #413 harm.
wrapper_pairing_guard() {
    for _wpg in wrapper_headless_classify wrapper_validate_cwd \
        wrapper_version_passthrough wrapper_refusal wrapper_banner \
        wrapper_update_note wrapper_advisories openchamber_guard \
        wrapper_path_shadow_warning wrapper_wsl_checks \
        wrapper_resolve_major wrapper_container_detect \
        wrapper_container_resolve wrapper_container_advisory \
        wrapper_serve_cwd_fallback wrapper_login_cwd_fallback \
        standalone_mode note _opk_timeout_ok merged_config \
        tools_from_config stop_merged_config_service sock_reachable \
        cwd_probe; do
        command -v "$_wpg" >/dev/null 2>&1 || {
            echo "error: as-opencode-core.sh is version-skewed ($_wpg missing) — refusing to run" >&2
            return 1
        }
    done
}
wrapper_pairing_guard || exit 1

# --- sections, in run order (output order is user-visible) --------------------
wrapper_headless_classify "$@"
wrapper_validate_cwd
wrapper_version_passthrough "$@"
wrapper_refusal
wrapper_banner
wrapper_update_note
wrapper_advisories
openchamber_guard
wrapper_path_shadow_warning
wrapper_wsl_checks
wrapper_resolve_major
wrapper_container_detect "$@"
wrapper_container_resolve
wrapper_container_advisory
wrapper_serve_cwd_fallback "$@"
wrapper_login_cwd_fallback "$@"

# opencode 2.x --standalone gating (issue #80): the verdict comes from
# the lib's standalone_mode; the ARG REWRITE stays top-level in the
# entry -- a `set --` inside a function cannot touch the caller's
# positional parameters. An explicit --server/--standalone in the
# user's args always wins (the lib's contract).
case $(standalone_mode "$@") in
    append)
        set -- "$@" --standalone
        ;;
    after-first)
        _sub="$1"
        shift
        set -- "$_sub" --standalone "$@"
        ;;
esac

# Rootless: pass the per-user socket through sudo's env reset via env_keep.
# podman-CLI path (daemonless): no DOCKER_HOST, no supplementary group.
# Containers run as the opencode host UID either way.
if [ -n "$CONTAINER_DOCKER_HOST" ]; then
    export DOCKER_HOST="$CONTAINER_DOCKER_HOST"
    [ -n "$CONTAINER_XDG" ] && export XDG_RUNTIME_DIR="$CONTAINER_XDG"
    exec /usr/bin/sudo -u opencode /usr/local/lib/opencode-permissions-kit/bin/opencode "$@"
fi
exec /usr/bin/sudo -u opencode /usr/local/lib/opencode-permissions-kit/bin/opencode "$@"
