#!/bin/sh
# opencode permissions kit -- ddev shim
#
# ddev rewrites project files as the launching developer (TYPO3 settings.php,
# config/system/*.php, .gitignore, .ddev build dirs). Running it as the
# 'opencode' user collides with the kit's file protections — hard ACL denies
# on settings/additional.php, developer-owned config dirs (755, no www-data
# write), and .ddev build dirs owned by the developer with no opencode write
# — so every `ddev` the opencode agent invokes is delegated to the DEFAULT_USER
# (the developer) via the kit's sudoers rule. Outside the opencode sandbox
# (the developer themselves, root, or any other user) the shim passes through
# to the real ddev untouched.
#
# Lives at /usr/local/lib/opencode-permissions-kit/bin/ddev, shadowed as /usr/local/bin/ddev
# (ahead of the real ddev in PATH). The real ddev path is recorded in
# /etc/opencode-permissions-kit/install.conf as DDEV_BIN at install time.

DEFAULT_USER=""
DDEV_BIN=""
# Read install.conf (new path first, fall back to pre-0.0.10 /etc/opencode/).
for _conf in /etc/opencode-permissions-kit/install.conf /etc/opencode/install.conf; do
    if [ -f "$_conf" ]; then
        DEFAULT_USER=$(sed -n 's/^DEFAULT_USER=//p' "$_conf")
        DDEV_BIN=$(sed -n 's/^DDEV_BIN=//p' "$_conf")
        break
    fi
done
[ -n "$DDEV_BIN" ] || DDEV_BIN="/usr/bin/ddev"

# Delegate only for the opencode sandbox user. The developer keeps their own
# ddev; other contexts pass through unchanged. The sudoers rule
# (opencode ALL=(DEFAULT_USER) NOPASSWD: DDEV_BIN) makes the delegation
# passwordless.
if [ "$(id -un)" = "opencode" ] && [ -n "$DEFAULT_USER" ] && [ -x /usr/bin/sudo ]; then
    exec /usr/bin/sudo -u "$DEFAULT_USER" "$DDEV_BIN" "$@"
fi

exec "$DDEV_BIN" "$@"