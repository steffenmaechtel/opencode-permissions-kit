#!/bin/sh
# opencode permissions kit -- bin/ddev-as-opencode
#
# Runs the REAL ddev binary as the 'opencode' user. This is the sudoers
# target for the developer's `ddev` shell function (ddev-terminal.sh):
# the developer's terminal calls `sudo -u opencode <this helper> ...`, the
# helper sanitizes the environment and execs the real ddev. Because ddev
# ALWAYS runs as the opencode user, `.ddev/` has exactly one owner — no more
# "chmod .ddev/.webimageBuild: operation not permitted" (the old collision
# where the developer owned .ddev but the agent's ddev ran as opencode).
#
# Security notes:
#   - The helper only ever execs the real ddev (resolved via PATH, then the
#     two standard locations). It is gated to this exact path in sudoers and
#     must never gain extra power.
#   - It refuses to run when the current user is NOT the opencode user — the
#     sudoers rule only grants DEFAULT_USER, but defense-in-depth.
#   - It re-derives HOME/XDG_RUNTIME_DIR/DOCKER_HOST because sudo's
#     env_reset drops them; without HOME a developer-invoked ddev would
#     write into /root instead of the opencode user's /home/<opencode>/.ddev.
#
# Deployed to /usr/local/lib/opencode-permissions-kit/bin/ddev-as-opencode.
set -u

# OPK_INSTALL_CONF overrides the stamp path for tests (same convention as
# ddev-handover.sh) — keeps the sourced mode stamp hermetic on hosts that
# run a real kit install next to the repo checkout.
INSTALL_CONF="${OPK_INSTALL_CONF:-/etc/opencode-permissions-kit/install.conf}"

OPENCODE_USER="opencode"
CONTAINER_BACKEND=""
OPENCODE_DOCKER_HOST=""
OPENCODE_PODMAN_SOCKET=""
if [ -f "$INSTALL_CONF" ]; then
    . "$INSTALL_CONF"
fi
OPENCODE_USER="${OPENCODE_USER:-opencode}"

# Guard: only the opencode user may run ddev through this helper. The shell
# function (ddev-terminal.sh) is only installed for the DEFAULT user, but
# this check makes direct execution the only other entry point.
OC_UID="$(id -u "$OPENCODE_USER" 2>/dev/null || echo 0)"
if [ "$(id -u)" != "$OC_UID" ]; then
    echo "ddev-as-opencode: must run as user '$OPENCODE_USER' (use: sudo -u $OPENCODE_USER ...)" >&2
    exit 1
fi

# --opk-ensure-shared <dir> (issue #94): re-assert group-write on a .ddev
# tree that ddev just created or regenerated. ddev hardcodes explicit
# 0755/0644 modes (os.MkdirAll / WriteFile), which neither the umask nor
# the inherited default ACL can widen — the ACL mask gets capped to r-x
# and the developer (sharing-group member) cannot write into the tree:
# `git pull` delivering .ddev/ files then fails with "permission denied".
# Running as the opencode user, this heal only ever touches
# opencode-owned entries (chmod is owner-only); git-created entries are
# already group-writable. Heavy generated subtrees are pruned
# (db_snapshots is chmod 0777 by ddev itself; import dumps are transient
# and gitignored). No new privilege: the opencode user could chmod its
# own files without this helper too — the sudoers gate on this exact
# path just makes the heal reachable from the ddev() shell function.
# Idempotent, best-effort, never fails.
if [ "${1:-}" = "--opk-ensure-shared" ]; then
    _opk_dir="${2:-}"
    if [ -n "$_opk_dir" ] && [ -d "$_opk_dir" ]; then
        find "$_opk_dir" \
            -type d \( -name db_snapshots -o -name import-db -o -name import-files \) -prune -o \
            -print0 2>/dev/null \
            | xargs -0 -r chmod g+w 2>/dev/null || true
    fi
    exit 0
fi

# --opk-devowned-flag <project-dir> (issue #149, finding 1): dev-owned
# mode writes disable_settings_management: true into the project's
# .ddev/config.yaml right after `ddev config` created it — new projects
# are dev-owned from birth instead of silently running the handover
# model until the next root-run scan (the stamp-skipped `opk update`
# never picks new projects up, and no EPERM ever told the developer).
# Reached from the developer's ddev() hook through the same sudoers
# rule; runs as the opencode user (guard above) but needs no new
# privilege: a fresh `ddev config` wrote config.yaml AS opencode, a
# clone's config.yaml is group-writable — and ddev_devowned_flag itself
# skips symlinked configs and never writes through them. The mode check
# (ddev_devowned_enabled) lives inside, so callers may invoke
# unconditionally; the function's echo ("commit it") is the
# developer-visible hint. Best-effort, never fails.
if [ "${1:-}" = "--opk-devowned-flag" ]; then
    _opk_proj="${2:-}"
    # The flag writer ships as a sibling lib (repo checkout and deployed
    # kit alike); the fixed deployed path when invoked without a slash.
    case "$0" in
        */*) _opk_lib="$(dirname "$0")/../sh/ddev-handover.sh" ;;
        *)   _opk_lib="/usr/local/lib/opencode-permissions-kit/sh/ddev-handover.sh" ;;
    esac
    if [ -n "$_opk_proj" ] && [ -f "$_opk_proj/.ddev/config.yaml" ] && [ -f "$_opk_lib" ]; then
        # shellcheck disable=SC1091  # sibling lib, checked above
        . "$_opk_lib"
        if ddev_devowned_enabled; then
            ddev_devowned_flag "$_opk_proj"
        fi
    fi
    exit 0
fi

# Resolve the real ddev binary: first on PATH (sudo's env_reset keeps a
# sane default PATH), then the two standard locations. Never a kit shim.
DDEV=""
for cand in "$(command -v ddev 2>/dev/null || true)" /usr/local/bin/ddev /usr/bin/ddev; do
    [ -n "$cand" ] || continue
    if [ -x "$cand" ]; then
        DDEV="$cand"
        break
    fi
done
if [ -z "$DDEV" ]; then
    echo "ddev-as-opencode: ddev is not installed. Install ddev >= 1.25 and re-run." >&2
    exit 127
fi

# Environment: sudo's env_reset dropped the opencode user's values; the
# developer's would point at the wrong user. HOME via getent (0.0.43b W2):
# a custom OPENCODE_USER with a relocated home must still resolve —
# /home/<name> stays the last-resort fallback only.
OC_HOME="$(getent passwd "$OPENCODE_USER" 2>/dev/null | cut -d: -f6 || true)"
export HOME="${OC_HOME:-/home/$OPENCODE_USER}"
if [ -n "$OC_UID" ] && [ "$OC_UID" != "0" ]; then
    export XDG_RUNTIME_DIR="/run/user/$OC_UID"
fi

case "${CONTAINER_BACKEND:-}" in
    docker-rootless)
        [ -n "${OPENCODE_DOCKER_HOST:-}" ] && export DOCKER_HOST="$OPENCODE_DOCKER_HOST"
        ;;
    podman-rootless)
        # Optional docker-CLI compat socket; without it ddev talks to the
        # podman socket directly via XDG_RUNTIME_DIR (daemonless path).
        [ -n "${OPENCODE_PODMAN_SOCKET:-}" ] && export DOCKER_HOST="$OPENCODE_PODMAN_SOCKET"
        ;;
esac

# Working-directory fallback (issue #51): sudo keeps the caller's cwd, so
# the opencode process can inherit a directory it cannot search — the
# developer's $HOME is 0750 on Ubuntu 24.04, and `ddev poweroff` is a
# command you naturally run from there. ddev's embedded compose schema is
# registered under a RELATIVE resource name, so every compose load
# resolves it against the process cwd (os.Getwd -> stat "."), which fails
# with 'error in parsing "compose-spec.json": stat .: permission denied'
# there — a warning per project on cwd-independent runs (`ddev poweroff`,
# `ddev stop <project>`), while the stop itself still succeeds. Probe the
# inherited cwd from the process itself (not $PWD) and fall back to the
# opencode home: registry-driven commands then run clean, and commands
# that need the cwd (bare `ddev start`) would fail in such a directory
# anyway — the stderr note keeps that failure explainable. Never aborts:
# when even the fallback cd fails, ddev runs with the inherited cwd as
# before.
if ! [ -x . ]; then
    echo "ddev-as-opencode: current directory is not accessible to the opencode user - continuing in $HOME" >&2
    cd "$HOME" 2>/dev/null || true
fi

umask 002
exec "$DDEV" "$@"
