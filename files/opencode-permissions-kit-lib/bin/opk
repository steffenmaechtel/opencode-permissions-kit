#!/bin/sh
# opencode permissions kit -- bin/opk (CLI dispatcher)
# Deployed to /usr/local/bin/opk by install.sh
# (symlink -> /usr/local/lib/opencode-permissions-kit/bin/opk).
#
# One command for all management scripts, usable from anywhere in WSL:
#   opk status     -> management/status.sh   (no sudo needed)
#   opk doctor     -> management/doctor.sh   (no sudo needed; per-project
#                  read-only ownership diagnosis, issue #313; 'doctor fix'
#                  orchestrates the handover remedy, elevation stays
#                  inside handover; 'doctor detect' proposes opk.json
#                  entries, #352; 'doctor all' scans every opk.json
#                  marker project, #354)
#   opk config ... -> management/config.sh   (auto sudo)
#   opk update ... -> management/update.sh   (auto sudo)
#   opk uninstall  -> management/uninstall.sh (runs as your user,
#                                            asks for sudo itself)
#
# wsl-add-opencode-1-fix is implemented inline (explicit-consent wsl.conf
# write, internal/records/wsl-conf-consent.md).
#
# Everything after the subcommand is passed through to the script, so all
# script flags work unchanged (see docs/reference/cli.md).
set -u

# Resolve the library root through the /usr/local/bin/opk symlink. The
# dispatcher lives in bin/, so the root is one directory up.
# FULL chain (#211 a F15): the single-hop readlink broke chained user
# symlinks (~/bin/opk -> /usr/local/bin/opk -> lib) — SELF stopped one
# hop short, LIBDIR resolved wrong, and every subcommand reported
# "not found" with a misleading "is the kit installed?" error. Sibling
# shape: bin/ddev-migrate:13, bin/xdg-open:47.
SELF="$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")"
LIBDIR="$(cd "$(dirname "$SELF")/.." && pwd -P)"

# Shared UI helpers — same visual language as every kit script (labeled
# error lines, colors off when piped). $LIBDIR is resolved above.
if [ -f "$LIBDIR/sh/ui.sh" ]; then
    . "$LIBDIR/sh/ui.sh"
else
    # Minimal fallbacks: plain, colorless, same argument shapes — every
    # ui_* helper opk uses must exist even when the library is damaged.
    ui_error() { echo "  error    $1" >&2; }
    ui_info() { echo "  info     $1"; }
    ui_success() { echo "  ok       $1"; }
    ui_warn() { echo "  warn     $1" >&2; }
    ui_detail() { echo "           $1"; }
    ui_confirm() { # <question> <y|n default> — reads /dev/tty; EOF or
        # unrecognized input follows the CALLER'S default (the same
        # semantics as sh/ui.sh's ui_confirm, #370 a E3 — NOT "fails
        # closed": under a y default an unattended EOF answers yes)
        printf '  %s ' "$1" >&2
        case "$2" in y | Y) printf '[Y/n] ' >&2 ;; *) printf '[y/N] ' >&2 ;; esac
        read -r _uic </dev/tty 2>/dev/null || _uic=""
        # Lowercase BEFORE matching (issue #187 C): mixed-case answers
        # (Yes/No/yEs) used to miss the arms and silently become the
        # DEFAULT — an explicit No under a y default answered yes.
        # Semantics mirror ui.sh's ui_confirm: y/yes/n/no accepted
        # case-insensitively; the read trims edge whitespace (#189 a
        # W2), anything else (EOF, garbage) falls back to the default.
        _uic="$(printf '%s' "$_uic" | tr '[:upper:]' '[:lower:]')"
        case "$_uic" in
            y | yes) return 0 ;;
            n | no) return 1 ;;
            *) case "$2" in y | Y) return 0 ;; *) return 1 ;; esac ;;
        esac
    }
fi

# Walk-up opk.json discovery (#353 / #313 phase 4) — the SAME leaf lib
# doctor.sh resolves through (one shared resolution site, not a
# per-command copy; see sh/path-sane.sh). Used by the 'handover me'
# declared-tree warning. A damaged library degrades that warning to v1
# strict-cwd (a SUBSET: it then only sees a policy in the cwd itself)
# — advisory-only, so the dispatcher keeps working; every other
# subcommand is unaffected.
_OPK_POLICY_ROOT=0
if [ -f "$LIBDIR/sh/path-sane.sh" ]; then
    # shellcheck disable=SC1090
    . "$LIBDIR/sh/path-sane.sh"
    _OPK_POLICY_ROOT=1
fi

# OpenChamber bypass-binary probe (0.0.47a F3): shared semantics with the
# wrapper's guard — a file at ~/.opencode/bin/<name> that symlinks to the
# kit wrapper is NOT a bypass binary (never listed, never removed).
oc_bypass_bin() { # <path> -> rc 0 when the path is a bypass binary
    [ -e "$1" ] || return 1
    if [ -L "$1" ] && [ "$(readlink -f "$1" 2>/dev/null || echo "$1")" \
        = "/usr/local/lib/opencode-permissions-kit/bin/opencode-as-opencode" ]; then
        return 1
    fi
    return 0
}

# Version from install.conf (the deployed stamp — same source as status.sh;
# a standalone VERSION file is not deployed to the library). OPK_INSTALL_CONF
# overrides the path for tests only.
VERSION="0.0.0"
INSTALL_CONF="${OPK_INSTALL_CONF:-/etc/opencode-permissions-kit/install.conf}"
if [ -f "$INSTALL_CONF" ]; then
    _v=$(sed -n 's/^VERSION=//p' "$INSTALL_CONF" | tail -1)
    [ -n "$_v" ] && VERSION="$_v"
fi

usage() {
    cat <<EOF
opencode permissions kit  v$VERSION

Usage: opk <command> [args...]

Commands:
  status [--short]                 Show the protection status (no sudo needed);
                                   --short: only the final verdict line, with it
                                   in the exit code (0 green, 1 alerts, 2 warnings)
  doctor [path]                    Deep diagnosis for the current project (read-only,
                                   no sudo): classifies file ownership in the
                                   container trees the project declares in its
                                   opk.json as mapped-safe or at-risk for the
                                   rootless backend (the EPERM build-breaker
                                   class) and prints the fix commands. <path>
                                   defaults to the cwd; exit codes like status
  doctor fix [path] [--dry-run]    The guided remedy for the at-risk findings:
                                   offers 'opk handover opencode <tree>' per
                                   tree, one [y/N] prompt each (default n);
                                   --dry-run shows the plan and changes
                                   nothing. doctor never elevates itself — the
                                   sudo hop happens inside handover (no new
                                   sudoers surface); exit codes like status
  doctor detect [path]             Propose opk.json entries from ownership
                                   evidence (subuid twins, daemon-owned
                                   gitignored paths): one [y/N] consent per
                                   candidate (default n), the snippet to paste
                                   on decline; read-only unless consented;
                                   exit codes like status
  doctor all [scan-root]           Run the doctor scan for EVERY project at
                                   once: every opk.json found (up to 3 levels
                                   below a scan root) is one project, one full
                                   scan each, findings aggregated per project.
                                   Default scan roots: /var/www/vhosts plus
                                   the registered projects.conf roots; a
                                   positional scans exactly that tree. Exit
                                   codes worst-of: 0 all green, 1 any alert,
                                   2 warnings only or nothing scanned
  config <args...>                Change settings: status (git-config +
                                  projects overview), projects
                                  list|add|remove,
                                  git-config on|off|status,
                                  container-backend <backend>|status, refresh,
                                  handover <path...> (ddev ownership repair
                                  for a freshly cloned project),
                                  ddev-settings on|off|status (dev-owned
                                  projects)
  update [--yes] [--refresh]      Re-deploy the kit; --binary / --binary-path
                                   upgrade the opencode binary; --only-binary
                                   skips every kit step and only upgrades it;
                                   --channel <ref> switches the tracking ref
                                   (stable, master, a branch, a tag) for this
                                   and every future update; --major 1|2
                                   switches the opencode major, --version <ver>
                                   pins an exact version (default: latest of
                                   the current major — never crosses majors)
  upgrade-opencode [flags...]     Just upgrade the opencode binary — shorthand
                                   for 'update --yes --only-binary' (extra
                                   flags pass through, e.g. --binary-path,
                                   --major 1|2, --version <ver>)
  openchamber-secure [--yes]       Pin OpenChamber's opencode spawn to the
                                   kit wrapper (/etc/openchamber/policy.json
                                   — its self-update buttons go dark, updates
                                   go through opk upgrade-opencode) and remove
                                   leftover one-click bypass files. Idempotent;
                                   the later equivalent of the install prompt
  ddev-hosts-add [dir|hostname]     Add ddev hostnames to the Windows hosts
                                   file (ddev's own UAC flow; run as your
                                   user, Windows asks permission). A dir adds
                                   that project's missing hostnames, a
                                   hostname adds exactly that one
  ddev-hosts-check [dir]            List this project's ddev hostnames missing
                                    from the Windows hosts file
  handover <me|opencode> <path>...  Recursively hand file ownership to you (me)
                                     or the agent user (opencode) — the sharing
                                     group stays, so both sides keep access. For
                                     mixed-owner trees, e.g. after builds by
                                     both users. --dry-run shows the plan
  ensure-shared [<dir>]             Re-assert group-write on a .ddev tree a
                                     ddev run left without it — the
                                     'ddev share' fix opk status prints.
                                     <dir> defaults to ./.ddev; runs as the
                                     agent user (sudo -u) and changes modes
                                     only, never ownership
  wsl-add-opencode-1-fix            Write the WSL browser-bridge carrier into
                                     /etc/wsl.conf (sudo). The only kit command
                                     that touches wsl.conf — explicit consent:
                                     install/update never do. Keeps device
                                     logins alive on a hardened /mnt/c for
                                     open@10 versions (1.x < 1.18.33,
                                     2.x < 2.0.18)
  uninstall [--yes] [--dry-run] [--debug]   Remove the kit (runs as your user)
  --version                       Print the deployed kit version and exit
  help                            Show this help

Everything after <command> is passed to the underlying script, so all
flags from the scripts work unchanged. Direct calls still work too:
  /usr/local/lib/opencode-permissions-kit/management/<script>.sh

Docs: https://github.com/steffenmaechtel/opencode-permissions-kit/blob/master/docs/reference/cli.md
EOF
}

cmd="${1:-}"
[ $# -gt 0 ] && shift

case "$cmd" in
    status)
        exec sh "$LIBDIR/management/status.sh" "$@"
        ;;
    doctor)
        # Per-project deep diagnosis (issue #313): the scan is a
        # read-only ownership classification of the container trees the
        # project declares in opk.json -- mapped-safe vs at-risk for
        # container metadata ops (the #312 EPERM class). 'doctor fix'
        # additionally orchestrates the handover remedy; 'doctor detect'
        # (#352) proposes opk.json entries from ownership evidence;
        # 'doctor all' (#354 / #313 phase 5) runs the scan for every
        # project at once -- one fresh doctor process per discovered
        # opk.json-marker project (the deduped list spawns the children);
        # no sudo here either -- the elevation happens inside handover.
        exec sh "$LIBDIR/management/doctor.sh" "$@"
        ;;
    config | update)
        if [ ! -f "$LIBDIR/management/$cmd.sh" ]; then
            ui_error "$LIBDIR/management/$cmd.sh not found — is the kit installed?"
            exit 1
        fi
        if [ "$(id -u)" -eq 0 ]; then
            exec sh "$LIBDIR/management/$cmd.sh" "$@"
        fi
        exec sudo sh "$LIBDIR/management/$cmd.sh" "$@"
        ;;
    upgrade-opencode)
        # Binary-only shorthand (issue #24): update.sh --yes --only-binary,
        # extra flags pass through (--binary-path for offline installs).
        if [ ! -f "$LIBDIR/management/update.sh" ]; then
            ui_error "$LIBDIR/management/update.sh not found — is the kit installed?"
            exit 1
        fi
        if [ "$(id -u)" -eq 0 ]; then
            exec sh "$LIBDIR/management/update.sh" --yes --only-binary "$@"
        fi
        exec sudo sh "$LIBDIR/management/update.sh" --yes --only-binary "$@"
        ;;
    openchamber-secure)
        # OpenChamber hardening (issue #154, internal/records/openchamber-2x-hardening.md):
        # write the admin-owned policy pin (/etc/openchamber/policy.json) that
        # makes OpenChamber spawn the kit wrapper — retroactively defusing a
        # one-click settings pin — record the opt-in (opk update re-applies
        # the pin), and with consent remove leftover bypass binaries + the
        # settings pin (a pin without binaries hangs OpenChamber at startup).
        # Idempotent. Auto-sudo like config/update.
        OC_YES=false
        for _oca in "$@"; do
            case "$_oca" in
                --yes) OC_YES=true ;;
                *)
                    ui_error "unknown flag for openchamber-secure: $_oca (only --yes)"
                    exit 1
                    ;;
            esac
        done
        if [ "$(id -u)" -ne 0 ]; then
            exec sudo sh "$LIBDIR/bin/opk" openchamber-secure "$@"
        fi
        # Running as root from here.
        _oc_duser=$(sed -n 's/^DEFAULT_USER=//p' "$INSTALL_CONF" 2>/dev/null | tail -1)
        if [ -z "$_oc_duser" ]; then
            ui_error "DEFAULT_USER not found in $INSTALL_CONF — is the kit installed?"
            exit 1
        fi
        ui_info "Writing the OpenChamber policy pin ..."
        # 0.0.47a F1: this explicit command DOES replace divergent content
        # (that is its job) — but never silently: announce the replacement.
        _oc_expected='{ "opencodeBinary": "/usr/local/bin/opencode" }'
        if [ -f /etc/openchamber/policy.json ] &&
            [ "$(cat /etc/openchamber/policy.json 2>/dev/null)" != "$_oc_expected" ]; then
            ui_info "existing /etc/openchamber/policy.json diverges from the kit pin — replacing it"
        fi
        mkdir -p /etc/openchamber
        # Atomic stage+mv (#211 a F17, the 0.0.44a V10 sibling gap): a
        # kill mid-redirect used to leave a truncated/empty policy.json
        # and silently deactivate the pin — the live file now flips via
        # rename only, the truncate window sits on the pid-suffixed
        # temp (0.0.42e C5 shape).
        _ocp_tmp="/etc/openchamber/policy.json.opk-new.$$"
        # The write's rc is gated too (#211 c W7): opk carries no set -e,
        # so a partially-written temp (create ok, write fails — ENOSPC)
        # flowed through chown || true and chmod+mv — both succeed on the
        # truncated file — installing a broken pin under ui_success.
        # (Deliberately an `|| { …; }` one-liner: the F17 pin's extract
        # ends at this block's first 8-space `fi` — a second one would
        # truncate it.)
        printf '{ "opencodeBinary": "/usr/local/bin/opencode" }\n' >"$_ocp_tmp" ||
            {
                rm -f "$_ocp_tmp"
                ui_error "could not stage the policy pin (write to the temp failed)"
                exit 1
            }
        chown root:root "$_ocp_tmp" 2>/dev/null || true
        # Failure path cleans the staged temp (#211 b W8): opk carries
        # no cleanup trap, and the pid suffix means a stranded
        # root-owned .opk-new.$$ in /etc is never cleaned by a later
        # run. mv -f replaces a symlink at policy.json rather than
        # writing through it (#211 b W19) — the announced replace is
        # this command's documented job.
        if ! { chmod 644 "$_ocp_tmp" && mv -f "$_ocp_tmp" /etc/openchamber/policy.json; }; then
            rm -f "$_ocp_tmp"
            ui_error "could not install the policy pin (chmod/mv on the staged temp failed)"
            exit 1
        fi
        ui_success "policy pin active: /etc/openchamber/policy.json -> /usr/local/bin/opencode"
        # Record the opt-in so update.sh keeps re-applying the pin.
        if grep -q '^OPENCHAMBER_POLICY=' "$INSTALL_CONF" 2>/dev/null; then
            sed -i 's/^OPENCHAMBER_POLICY=.*/OPENCHAMBER_POLICY=yes/' "$INSTALL_CONF"
        else
            printf '\nOPENCHAMBER_POLICY=yes\n' >>"$INSTALL_CONF"
        fi
        # Leftover bypass files: inert under the policy, but removing them
        # now avoids the startup hang if the policy ever disappears.
        # HOME via getent, not /home/<user> (0.0.43b W1 class); a kit
        # symlink to the wrapper is never a bypass binary (0.0.47a F3).
        _oc_home=$(getent passwd "$_oc_duser" 2>/dev/null | cut -d: -f6 || true)
        if [ -z "$_oc_home" ]; then
            ui_detail "could not resolve the home of '$_oc_duser' — leftover scan skipped"
            ui_detail "restart OpenChamber if it is running (full stop + start)"
            exit 0
        fi
        _oc_found=""
        for _ocn in opencode opencode2; do
            if oc_bypass_bin "$_oc_home/.opencode/bin/$_ocn"; then
                _oc_found="x"
            fi
        done
        _oc_settings="$_oc_home/.config/openchamber/settings.json"
        if grep -q '"opencodeBinary"' "$_oc_settings" 2>/dev/null; then
            _oc_found="x$_oc_found"
        fi
        if [ -z "$_oc_found" ]; then
            ui_detail "no leftover bypass files found"
            ui_detail "restart OpenChamber if it is running (full stop + start)"
            exit 0
        fi
        echo ""
        ui_info "Leftover bypass files found (inert under the policy):"
        for _ocn in opencode opencode2; do
            oc_bypass_bin "$_oc_home/.opencode/bin/$_ocn" &&
                ui_detail "  $_oc_home/.opencode/bin/$_ocn"
        done
        grep -q '"opencodeBinary"' "$_oc_settings" 2>/dev/null &&
            ui_detail "  settings pin: \"opencodeBinary\" in $_oc_settings"
        if [ "$OC_YES" != true ]; then
            # (#370 a E3): default n (the conventions' system-change
            # direction, agent/conventions.md "Interactive prompts" —
            # removal changes the system). Under the old y default an unattended EOF (the
            # fallback confirm follows the caller's default) REMOVED
            # the bypass files; scripted callers use --yes.
            if ! ui_confirm "Remove them now?" "n"; then
                ui_detail "kept — 'sudo opk openchamber-secure' removes them later"
                ui_detail "restart OpenChamber if it is running (full stop + start)"
                exit 0
            fi
        fi
        for _ocn in opencode opencode2; do
            oc_bypass_bin "$_oc_home/.opencode/bin/$_ocn" &&
                rm -f "$_oc_home/.opencode/bin/$_ocn"
        done
        ui_success "bypass binaries removed (if present)"
        if grep -q '"opencodeBinary"' "$_oc_settings" 2>/dev/null; then
            # Guard and execution share ONE resolution context (#244 f W2,
            # the e-S1 class): the guard runs inside the sudo context, so
            # a secure_path that differs from the caller's PATH cannot make
            # the two disagree (not-found noise on one arm, a skipped edit
            # sudo could perform on the other). Operands pass as argv to
            # the inner sh; the heredoc feeds python3's stdin through it.
            # -I (#249, review a C2): the tui-plugin twin's shape — the
            # edit must not follow a poisoned PYTHONHOME/PYTHONPATH
            # (sudo's env_reset strips them today; env_keep re-opens it).
            if sudo -u "$_oc_duser" sh -c 'command -v python3 >/dev/null 2>&1 && exec python3 -I "$@"' \
                opk-settings-edit - "$_oc_settings" <<'PYEOF'
import json, sys, pathlib
p = pathlib.Path(sys.argv[1])
try:
    d = json.loads(p.read_text())
except ValueError:
    sys.exit(1)
if isinstance(d, dict) and "opencodeBinary" in d:
    del d["opencodeBinary"]
    p.write_text(json.dumps(d, indent=2) + "\n")
else:
    # No key removed (#244 g S1): the caller's grep hit the literal
    # as a VALUE — report failure instead of a false success.
    sys.exit(1)
PYEOF
            then
                ui_success "settings pin removed from $_oc_settings"
            else
                # Four rc-1 causes share this branch, deliberately
                # (#244 h S3): no key removed (g S1), unparseable
                # JSON, python3 missing, write failure — all fail
                # closed; the unit pin separates via empty stderr.
                # pr-00263 c C2: failing closed includes the rc — the
                # branch used to fall through to exit 0.
                ui_error "could not update $_oc_settings — remove the \"opencodeBinary\""
                ui_error "entry (key or value) by hand — docs/how-to/openchamber.md"
                exit 1
            fi
        fi
        ui_detail "restart OpenChamber if it is running (full stop + start)"
        ;;
    uninstall)
        if [ ! -f "$LIBDIR/management/uninstall.sh" ]; then
            ui_error "$LIBDIR/management/uninstall.sh not found — is the kit installed?"
            exit 1
        fi
        # uninstall.sh expects the default user (no sudo prefix); it asks
        # for sudo itself via sudo -v.
        exec sh "$LIBDIR/management/uninstall.sh" "$@"
        ;;
    ddev-hosts-add | ddev-hosts-check)
        # Windows hosts bridge: must run AS THE DEVELOPER (interop + the
        # Windows user's drvfs access), never as root/opencode. Sourced
        # lib, functions called inline — argument passing stays simple.
        [ -f "$LIBDIR/sh/ddev-hosts.sh" ] ||
            {
                ui_error "$LIBDIR/sh/ddev-hosts.sh not found — is the kit installed?"
                exit 1
            }
        # shellcheck disable=SC1090
        . "$LIBDIR/sh/ddev-hosts.sh"
        if [ "$(id -u)" -eq 0 ]; then
            _kitsu=""
            [ -f /etc/opencode-permissions-kit/install.conf ] &&
                _kitsu=$(sed -n 's/^DEFAULT_USER=//p' /etc/opencode-permissions-kit/install.conf | tail -1)
            [ -n "$_kitsu" ] || _kitsu="${SUDO_USER:-}"
            if [ -z "$_kitsu" ] || [ "$(id -u "$_kitsu" 2>/dev/null || echo 0)" = "0" ]; then
                ui_error "cannot resolve the developer user — run as your user, not as root"
                exit 1
            fi
            # Nothing user-controlled in the sh -c body (0.0.38 C23): the function
            # name comes from the fixed cmd dispatch above, the lib path is
            # kit-owned, and the project path travels as an argument.
            case "$cmd" in
                ddev-hosts-check) _kitfn=ddev_hosts_missing ;;
                ddev-hosts-add) _kitfn=ddev_hosts_add ;;
                *)
                    ui_error "unknown command: $cmd"
                    exit 1
                    ;;
            esac
            # HOME via getent, not /home/<user> (0.0.43b W1): after this
            # re-exec ddev_hosts_add runs AS the developer, so its own
            # getent fix (0.0.43a F12) never fires on this path — the
            # value passed here is the one ddev sees. A relocated home
            # must still give it the real registry/config.
            _kit_home=$(getent passwd "$_kitsu" 2>/dev/null | cut -d: -f6 || true)
            [ -n "$_kit_home" ] || _kit_home="/home/$_kitsu"
            exec sudo -u "$_kitsu" env HOME="$_kit_home" \
                sh -c '. "$1" && "$2" "$3"' _ "$LIBDIR/sh/ddev-hosts.sh" "$_kitfn" "${1:-$PWD}"
        fi
        case "$cmd" in
            ddev-hosts-check)
                _khm=$(ddev_hosts_missing "${1:-$PWD}")
                if [ -z "$_khm" ]; then
                    echo "all ddev hostnames already in $DDEV_WIN_HOSTS"
                else
                    echo "missing from $DDEV_WIN_HOSTS:"
                    printf '%s\n' "$_khm" | sed 's/^/  /'
                    echo "add them (one command each):"
                    printf '%s\n' "$_khm" | sed 's/^/  opk ddev-hosts-add /'
                fi
                ;;
            ddev-hosts-add)
                ddev_hosts_add "${1:-$PWD}"
                ;;
        esac
        ;;
    wsl-add-opencode-1-fix)
        # Explicit consent for the /etc/wsl.conf browser-bridge carrier
        # (internal/records/wsl-conf-consent.md): install/update never write
        # wsl.conf — only THIS command, run by the user, does. It (re)deploys
        # the stand-in tree from the library and writes the kit comment
        # block (pure comments for WSL, issue #100); a legacy 0.0.36
        # section is cleaned up on the way, and only kit content is ever
        # removed or added. Auto-sudo like config/update.
        [ -f "$LIBDIR/sh/wsl-browser-bridge.sh" ] ||
            {
                ui_error "$LIBDIR/sh/wsl-browser-bridge.sh not found — is the kit installed?"
                exit 1
            }
        if [ "$(id -u)" -ne 0 ]; then
            exec sudo sh "$LIBDIR/bin/opk" "$cmd"
        fi
        # Running as root: the bridge helper's writes need no sudo prefix.
        OPK_WSL_SUDO=""
        export OPK_WSL_SUDO
        # shellcheck disable=SC1090
        . "$LIBDIR/sh/wsl-browser-bridge.sh"
        browser_bridge_is_wsl || {
            ui_error "not WSL — the browser bridge is WSL-only"
            exit 1
        }
        # Redeploy the stand-in when the source is in the library; older
        # deploys (update before browser-bridge joined the library) may only
        # have the tree — fine, the carrier is the missing piece then.
        if [ -f "$LIBDIR/bin/browser-bridge" ]; then
            browser_bridge_deploy_tree "$LIBDIR/bin/browser-bridge" "$LIBDIR"
        elif [ ! -x "$LIBDIR/wsl/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe" ]; then
            ui_error "stand-in missing and no $LIBDIR/bin/browser-bridge — run 'sudo opk update' first"
            exit 1
        fi
        # 0.0.45c C4: the write's rc decides the message — the old
        # unconditional success lied when _bb_install_conf failed (the
        # trailing tmp-cleanup used to swallow the failure).
        if browser_bridge_write_conf "$LIBDIR"; then
            ui_success "WSL browser bridge active — opencode device logins survive a hardened /mnt/c (1.x < 1.18.33, 2.x < 2.0.18)"
            ui_detail "carrier written to /etc/wsl.conf as a comment block (WSL ignores it;"
            ui_detail "takes effect immediately, no 'wsl --shutdown' needed)"
            ui_detail "'opk uninstall' removes the block again"
        else
            ui_error "could not write the carrier to /etc/wsl.conf — nothing was changed"
            ui_detail "check the errors above (permissions, disk space); /etc/wsl.conf is untouched"
            exit 1
        fi
        ;;
    handover)
        # Generic ownership switch between the two kit users (mixed-
        # owner trees): recursive chown to <target user> + the kit's
        # sharing group, then g+w -- ddev-handover.sh semantics for
        # any path. The arm's logic lives in sh/handover-core.sh
        # (#346 wave shape, #415 ride-along -- bin/opk is the kit's
        # flat dispatcher; this arm was its largest cohesive non-
        # dispatcher block). Checkout-first by construction: LIBDIR
        # is SELF-resolved, so a checkout opk runs the checkout's
        # core. Pairing guard: a version-skewed lib (the function
        # missing) refuses loud instead of printing not-found and
        # continuing -- bin/opk sets no set -e.
        HANDOVER_CORE="$LIBDIR/sh/handover-core.sh"
        if [ -f "$HANDOVER_CORE" ]; then
            # shellcheck disable=SC1090
            . "$HANDOVER_CORE"
        else
            ui_error "handover: handover-core.sh not found (expected $LIBDIR/sh/handover-core.sh) — is the kit installed?"
            exit 1
        fi
        command -v handover_core >/dev/null 2>&1 || {
            ui_error "handover: handover-core.sh is version-skewed (handover_core missing) — refusing to run"
            exit 1
        }
        handover_core "$@"
        ;;
    ensure-shared)
        # Short heal wrapper (issue #159): the one-command fix `opk
        # status` prints for a flagged .ddev tree used to be the full
        # sudo path to bin/ddev-as-opencode --opk-ensure-shared. This
        # subcommand is that exact call behind a short name. No new
        # privilege: the sudoers grant for the helper predates it
        # (templates/sudoers.template allows the developer any args on
        # that exact binary), the helper's uid guard still demands the
        # agent user, and its chmod stays owner-only — opencode-owned
        # entries only, never an ownership change (dev-owned entries
        # without g+w are the developer's umask business, the same
        # parity ddev_reshare_needed detects on). Validation runs
        # BEFORE the sudo hop, so usage errors need no elevation.
        _es_err() {
            ui_error "$1"
            echo "  usage: opk ensure-shared [<project>/.ddev]   (default: ./.ddev)" >&2
            exit 1
        }
        [ "$#" -le 1 ] || _es_err "ensure-shared: exactly one directory expected (got $# arguments)"
        _es_dir="${1:-$PWD/.ddev}"
        [ -f "$INSTALL_CONF" ] || _es_err "ensure-shared: $INSTALL_CONF not found — is the kit installed?"
        _es_user=$(sed -n 's/^OPENCODE_USER=//p' "$INSTALL_CONF" 2>/dev/null | tail -1)
        [ -n "$_es_user" ] || _es_err "ensure-shared: install.conf has no OPENCODE_USER"
        id -u "$_es_user" >/dev/null 2>&1 || _es_err "ensure-shared: user '$_es_user' does not exist"
        _es_helper="$LIBDIR/bin/ddev-as-opencode"
        [ -f "$_es_helper" ] || _es_err "ensure-shared: $_es_helper not found — is the kit installed?"
        [ -d "$_es_dir" ] || _es_err "ensure-shared: no such directory: $_es_dir (pass the project's .ddev tree)"
        if [ "$(id -u)" = "$(id -u "$_es_user" 2>/dev/null || echo x)" ]; then
            # Already the agent user (e.g. an agent session running the
            # heal itself): direct call, no sudo hop.
            ui_info "re-asserting group-write on $_es_dir ..."
            "$_es_helper" --opk-ensure-shared "$_es_dir"
            _es_rc=$?
        else
            ui_info "re-asserting group-write on $_es_dir as user '$_es_user' ..."
            sudo -u "$_es_user" "$_es_helper" --opk-ensure-shared "$_es_dir"
            _es_rc=$?
        fi
        if [ "$_es_rc" -eq 0 ]; then
            ui_success "group-write re-asserted on $_es_dir (owner-only chmod, ownership untouched)"
            ui_detail "still flagged by 'opk status'? dev-owned entries without g+w are"
            ui_detail "deliberately not healed; 'opk config handover <project-root>' re-runs the full handover"
        else
            ui_error "the heal could not run (exit $_es_rc); the underlying call, for direct use:"
            ui_detail "      sudo -u $_es_user $_es_helper --opk-ensure-shared \"$_es_dir\""
            exit "$_es_rc"
        fi
        ;;
    --version)
        # One-line machine-friendly version probe (issue #130): the same
        # install.conf stamp as the usage header and status.sh report.
        echo "opk $VERSION"
        ;;
    help | --help | -h)
        usage
        ;;
    "")
        usage
        exit 1
        ;;
    *)
        ui_error "unknown command '$cmd'"
        echo "" >&2
        usage >&2
        exit 1
        ;;
esac
