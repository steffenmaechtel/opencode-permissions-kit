#!/bin/sh
# opencode permissions kit -- bin/ddev-migrate
# CLI dispatcher for the ddev database migration bridge (issue #15).
# The functions live in sh/ddev-migrate.sh (sourced by install.sh);
# this entry point makes them a command (internal/records/streamline.md):
#   sudo /usr/local/lib/opencode-permissions-kit/bin/ddev-migrate export <dev-user> <root> [root ...]
#   sudo /usr/local/lib/opencode-permissions-kit/bin/ddev-migrate import [dump-dir]
#   /usr/local/lib/opencode-permissions-kit/bin/ddev-migrate list
set -u

# Resolve the library root through this script's real path (checkout and
# deployed kit alike): bin/ddev-migrate -> <libdir>/sh/ddev-migrate.sh.
SELF="$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")"
OPK_MIG_LIB="$(cd "$(dirname "$SELF")/../sh" 2>/dev/null && pwd -P)"
if [ -z "$OPK_MIG_LIB" ] || [ ! -f "$OPK_MIG_LIB/ddev-migrate.sh" ]; then
    echo "ddev-migrate: ddev-migrate.sh not found next to bin/ — is the kit installed?" >&2
    exit 1
fi
# shellcheck disable=SC1090
. "$OPK_MIG_LIB/ddev-migrate.sh"

case "${1:-}" in
    list)
        dm_found=0
        for dm_d in "$DDEV_MIG_BACKUP_ROOT"/ddev-migration-*; do
            [ -d "$dm_d" ] || continue
            dm_found=1
            echo "$dm_d:"
            # Entry names inside a finalized dump dir are agent-owned
            # (finalize hands the dir to the opencode user): a hostile
            # rename can put terminal-escape bytes into a name, and raw
            # ls output would let them forge/clear transcript lines —
            # scrub for display, run-collapsing like sh/ddev-migrate.sh
            # (#646, from PR #642 round c S2; the #642 a S1 /
            # pr-00263 a F9 transcript-forgery class).
            ls -1 "$dm_d" 2>/dev/null | LC_ALL=C sed -e 's/[^ -~][^ -~]*/?/g' -e 's/^/    /'
        done
        # rc 0 means "listed fine" regardless of whether dumps exist
        # (#211 a F3): the bare `&& echo` tail made the case arm's rc
        # 1 whenever dump directories WERE found — success read as
        # failure for every scripted caller of a diagnostics command.
        if [ "$dm_found" = 0 ]; then
            echo "no dump directories under $DDEV_MIG_BACKUP_ROOT"
        fi
        ;;
    export)
        [ "$(id -u)" = 0 ] || {
            echo "ddev-migrate: export must run as root"
            exit 1
        }
        [ $# -ge 3 ] || {
            _ddev_migrate_usage
            exit 1
        }
        # Agent user/group from install.conf, like the import path
        # (0.0.43a F15): a hand-edited conf with a custom OPENCODE_USER
        # must not leave the export's finalize chowns silently root-owned
        # (they are || true-guarded) — install.sh passes the configured
        # values too.
        dm_oc="opencode"
        [ -f /etc/opencode-permissions-kit/install.conf ] &&
            . /etc/opencode-permissions-kit/install.conf
        dm_oc="${OPENCODE_USER:-$dm_oc}"
        dm_ocg=$(id -gn "$dm_oc" 2>/dev/null || echo "$dm_oc")
        dm_dev="$2"
        shift 2
        ddev_migrate_export "$dm_dev" "$dm_oc" "$dm_ocg" "$@"
        ;;
    import)
        ddev_migrate_import "${2:-}"
        ;;
    registry)
        # Read-only diagnostics (runs as any user who can read the
        # registry): what an export WOULD take under the given roots —
        # and what silently falls outside (partial-export finding).
        [ $# -ge 2 ] || {
            _ddev_migrate_usage
            exit 1
        }
        dm_user="$2"
        shift 2
        dm_home=$(ddev_migrate_home "$dm_user")
        if [ $# -gt 0 ]; then
            echo "ddev registry of $dm_user — roots: $*"
            ddev_migrate_registry "$dm_home/.ddev" | while IFS='|' read -r dm_n dm_ar; do
                [ -n "$dm_ar" ] || continue
                dm_ar="${dm_ar%/}"
                # Display forms scrubbed (#660, pr-00657 a S2): name and
                # approot are registry-derived (project_list.yaml /
                # global_config.yaml under the queried user's home — the
                # opencode variant reads an agent-writable registry), and
                # a raw echo of either would let escape bytes forge/clear
                # transcript lines. Same scrub the sourced lib applies at
                # every display site (_ddev_migrate_show); the raw fields
                # stay the data currency for the gates below.
                dm_show=$(_ddev_migrate_show "$dm_n")
                dm_ashow=$(_ddev_migrate_show "$dm_ar")
                if ddev_migrate_under_roots "$dm_ar" "$@"; then
                    if [ -d "$dm_ar" ]; then
                        echo "  export:  $dm_show  ($dm_ashow)"
                    else
                        echo "  export:  $dm_show  ($dm_ashow — DIRECTORY MISSING)"
                    fi
                else
                    echo "  outside: $dm_show  ($dm_ashow)"
                fi
            done
        else
            echo "ddev registry of $dm_user:"
            # Bare list, same scrub over the whole line (the #646 list-arm
            # idiom, run-collapsing): the parser's output is registry-
            # derived, not operator-typed.
            ddev_migrate_registry "$dm_home/.ddev" |
                LC_ALL=C sed -e 's/[^ -~][^ -~]*/?/g' -e 's/^/  /'
        fi
        ;;
    *)
        _ddev_migrate_usage
        [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ] || exit 1
        ;;
esac
