#!/bin/sh
# post-* hook -- opencode permissions kit, git heal hooks (#671,
# operand set widened in #678).
#
# After a developer git operation rewrote the heal's operand metadata
# (.git/index, .git/HEAD and the measured lock+rename carriers --
# heal-index-head's header carries the full list), trigger the narrow
# root heal so the agent user keeps its main-checkout workflow (git
# add / git switch / git merge). This body is installed four times --
# post-merge, post-checkout, post-rewrite, post-index-change -- with
# identical bytes; the filename selects the git event:
#
#   post-merge         pull/merge, including fast-forward pulls
#   post-checkout      every checkout/switch (both -b and cross-commit)
#   post-rewrite       rebase / am
#   post-index-change  EVERY index write: mutating commands (add,
#                      reset, read-tree) AND refreshing `git status`
#                      runs on a stale cache (IDE refreshes while the
#                      agent edits). It does not fire when a
#                      fresh-cache status writes nothing -- exactly
#                      the no-flip case, so nothing is missed.
#
# (There is no post-reset hook in git; post-index-change is that
# family's real carrier -- measured live, #671 pilot.)
#
# The developer's global core.hooksPath (set by `opk git-heal on`)
# makes this run for EVERY repository of that user: the allowlist
# check below is a hard no-op outside kit-managed roots (no sudo
# call, no output). Never fails the git op: every path out is
# exit 0.
#
# Test overrides (unit suite only, never set in production):
#   GH_LIBDIR         base for the heal script (default
#                     /usr/local/lib/opencode-permissions-kit)
#   GH_PROJECTS_CONF  allowlist source (default
#                     /etc/opencode-permissions-kit/projects.conf)
#   GP_STORAGE        git-protection storage root for the fast path
#                     and the decline-marker check (#704; default
#                     GITDIR_STORAGE from
#                     /etc/opencode-permissions-kit/install.conf)
#   GP_NO_HINT=1      silence the git-protection adopt hint (fixtures
#                     that assert on clean stderr)
set -u

GH_LIBDIR="${GH_LIBDIR:-/usr/local/lib/opencode-permissions-kit}"
HEAL="$GH_LIBDIR/git-heal/heal-index-head"
CONF="${GH_PROJECTS_CONF:-/etc/opencode-permissions-kit/projects.conf}"

# Common gitdir of the repo the hook fires in (for a worktree that is
# the MAIN .git -- exactly the gitdir whose operand metadata matters).
# The plain form without --path-format keeps git 2.30 (the kit's
# tested floor) working; relative results resolve through cd + pwd -P.
cdg=$(git rev-parse --git-common-dir 2>/dev/null) || exit 0
[ -n "$cdg" ] || exit 0
case "$cdg" in
    /*) ;;
    *) cdg=$(cd -- "$cdg" 2>/dev/null && pwd -P) || exit 0 ;;
esac

# Hard no-op outside kit-managed roots (fast path -- no sudo spawn
# for any unrelated repository of the developer). Conf-line validity is
# the heal's gate: it re-validates every projects.conf line reader-side
# before authorizing anything (the files.md root-op contract, #674
# a A1) -- this fast path only decides whether to spawn it.
_gh_hit=0
if [ -f "$CONF" ]; then
    while IFS= read -r _gh_root; do
        case "$_gh_root" in '' | '#'*) continue ;; esac
        case "$cdg" in
            "$_gh_root" | "$_gh_root"/*)
                _gh_hit=1
                break
                ;;
        esac
    done <"$CONF"
fi

# git-protection storage (#704 O4): after adoption the common gitdir
# lives in the external storage -- OUTSIDE every projects.conf root.
# Accept it like a managed root (fast path only; heal-index-head's
# own reader gate stays the authority). GP_STORAGE is the test seam;
# the value "none" (declined marker) is not absolute and never
# matches. An unreadable install.conf degrades to empty -- silence,
# never a broken checkout (fail soft, the same discipline as $CONF).
_gp_storage="${GP_STORAGE:-$(sed -n 's/^GITDIR_STORAGE=//p' \
    /etc/opencode-permissions-kit/install.conf 2>/dev/null | tail -n 1)}"
if [ "$_gh_hit" != 1 ]; then
    case "$_gp_storage" in
        /*)
            case "$cdg" in
                "$_gp_storage" | "$_gp_storage"/*) _gh_hit=1 ;;
            esac
            ;;
    esac
fi
[ "$_gh_hit" = 1 ] || exit 0

# git-protection hint (#704 O4): a kit-managed tree whose .git is
# still a classic DIRECTORY carries the reopened wholesale arm
# (mv .git, #702). After adoption .git is a pointer FILE and this
# silences itself. Echo only -- never blocks the git op, needs no
# root (the adopt command elevates itself). Respects the decline
# marker (GITDIR_STORAGE=none): a host that said no is not nagged on
# every checkout. GP_NO_HINT=1 silences it for fixtures that assert
# on clean stderr.
if [ "$_gp_storage" != "none" ] && [ "${GP_NO_HINT:-}" != "1" ]; then
    _gp_top=$(git rev-parse --show-toplevel 2>/dev/null)
    if [ -n "$_gp_top" ] && [ ! -L "$_gp_top/.git" ] && [ -d "$_gp_top/.git" ]; then
        printf '[opk git-protection %s] kit-managed tree with classic .git layout (unprotected)\n' \
            "${0##*/}" >&2
        # Paste-safe adopt argument (#766): the printed line is data
        # until the developer pastes it -- then it is shell structure.
        # Folder names under the toplevel are agent-influenceable; a
        # space would split the word, a metacharacter would execute at
        # paste time. The hooks are standalone sh (no kit lib on
        # PATH), so this carries its own copy of the _gp_q spelling
        # (sh/git-protection-core.sh, #765 a S3): bare when plain,
        # single-quoted with '\'' escaping otherwise, NO command for a
        # control byte (rename the folder instead).
        _gp_hint=""
        case "$_gp_top" in
            *[[:cntrl:]]*) ;;
            -* | *[!A-Za-z0-9._/+-]*)
                _gp_hint="'"
                _gp_rest=$_gp_top
                while :; do
                    case "$_gp_rest" in
                        *"'"*)
                            _gp_hint="$_gp_hint${_gp_rest%%"'"*}'\\''"
                            _gp_rest=${_gp_rest#*"'"}
                            ;;
                        *)
                            _gp_hint="$_gp_hint$_gp_rest'"
                            break
                            ;;
                    esac
                done
                ;;
            *) _gp_hint=$_gp_top ;;
        esac
        if [ -n "$_gp_hint" ]; then
            printf '[opk git-protection %s] run: sudo opk git-protection adopt %s\n' \
                "${0##*/}" "$_gp_hint" >&2
        else
            printf '[opk git-protection %s] the toplevel path carries a control byte -- rename the folder, then adopt it\n' \
                "${0##*/}" >&2
        fi
    fi
fi

if command -v sudo >/dev/null 2>&1 && sudo -n "$HEAL" "$cdg" 2>/dev/null; then
    exit 0
fi
printf '[opk git-heal %s] heal skipped (sudo unavailable or failed) -- agent main-checkout workflow may be locked\n' \
    "${0##*/}" >&2
exit 0
