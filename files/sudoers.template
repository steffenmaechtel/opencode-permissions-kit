# opencode permissions kit — sudoers rule
# Deployed to /etc/opencode-permissions-kit/sudoers, symlinked as
# /etc/sudoers.d/opencode-permissions-kit. DEFAULT_USER is replaced at
# install time with the actual username.
#
# Soft protection model (docs/design/DDEV-WORKING.md): the wrapper execs
# opencode as the 'opencode' user against a rootless container backend —
# no supplementary docker group, no RunAs-developer ddev delegation, no
# root-side ACL helper. The opencode binary itself stays in the deny list,
# so this wrapper rule is the only path to run it.

# Preserve the rootless socket env across `sudo -u opencode`: the wrapper
# exports DOCKER_HOST (+XDG_RUNTIME_DIR) before the exec and sudo's env
# reset would drop them otherwise. OPENCODE_SERVER_PASSWORD stays too, so
# headless `opencode serve` (third-party UIs like OpenChamber, which pass
# the password they generate from --ui-password) does not silently lose
# its authentication. DDEV_DEBUG rides along for the `ddev launch` URL
# transport (ddev's launch script prints "FULLURL <url>" instead of
# opening a browser — the developer side opens it, see issue #20).
Defaults env_keep += "DOCKER_HOST XDG_RUNTIME_DIR OPENCODE_SERVER_PASSWORD DDEV_DEBUG"

# Base RunAs: the wrapper always execs opencode as the opencode user.
DEFAULT_USER ALL=(opencode) NOPASSWD: /usr/local/lib/opencode-permissions-kit/bin/opencode *

# Rootless socket reachability: the wrapper probes the docker-rootless /
# podman-rootless socket from the opencode user's own context, because the
# runtime dir (/run/user/<uid>) is mode 700 opencode:opencode and a
# developer-running wrapper cannot stat it. Gated to the kit's socket-check.sh
# helper only (it does nothing but `test -S`) — no arbitrary command execution.
DEFAULT_USER ALL=(opencode)  NOPASSWD: /usr/local/lib/opencode-permissions-kit/bin/socket-check.sh *

# ddev always runs as the opencode user (docs/design/DDEV-WORKING.md §7):
# the developer's `ddev` shell function (ddev-as-opencode.sh, hooked into
# .bashrc/.zshrc/.profile) execs this helper via sudo, so the terminal and
# the agent share one ddev home + one rootless daemon. The helper is gated
# to this exact path, re-sets HOME/XDG_RUNTIME_DIR/DOCKER_HOST for the
# opencode user, and only ever execs the real ddev binary.
DEFAULT_USER ALL=(opencode)  NOPASSWD: /usr/local/lib/opencode-permissions-kit/bin/ddev-as-opencode *
